# Env vars: FORCE_STOP_ALL
# Args: blockset IDs (defaults to all)
do_stop()
{
	[ -n "${IN_STOP}" ] && return 0 # prevent infinite loop

	local \
		CUR_CMD=stop \
		ASSERT_NOEXIT=1 \
		FAIL_STOP_REQ='' \
		IFS="${DEFAULT_IFS}" \
		stop_failed='' \
		dir \
		IN_STOP=1 \
		force_stop_all="${FORCE_STOP_ALL:-}" \
		set_id \
		set_ids

	debug_msg "" "STOP ${*:-"${SET_IDS}"}, force all: ${force_stop_all}" ""

	[ -n "${CONFIG_LOADED}" ] || load_config

	set_ids="${*:-"${SET_IDS}"}"
	[ -n "${set_ids}" ] || force_stop_all=1

	[ -z "${force_stop_all}" ] &&
	{
		get_valid_set_ids set_ids "${set_ids}" || return 1
		[ -z "${set_ids}" ] && return 0

		[ -n "${CONFIG_LOADED}" ] &&
		{
			[ -n "${GLOBAL_ENV_SET}" ] ||
			set_global_env
		} &&
		for set_id in ${set_ids}
		do
			eval "[ -n \"\${BL_ENV_SET_${set_id}}\" ]" || set_blocksets_env "${set_id}" || { stop_failed=1; break; }
		done &&
		[ -z "${stop_failed}" ] &&
		stop_blocksets "${set_ids}" &&
			return 0
	}

	[ -n "${force_stop_all}" ] || {
		[ -n "${set_ids}" ] && rm_conf_scripts "${set_ids}"
		commit_metadata
		return 1
	}

	reg_action -1 -purple "" "Stopping adblocking for any adblock-lean blocksets."

	rm -f "${META_FILE}" "${ABL_RUN_DIR:?}/${BLOCKSET_BASE_FNAME:-???}"*

	[ -n "${SET_IDS}" ] && [ -n "${CONFIG_LOADED}" ] &&
	{
		rm_conf_scripts &&
		rm_bk
	}

	IFS="${_NL_}"
	for dir in ${ALL_CONF_DIRS}${_NL_}/tmp/dnsmasq.d${_NL_}/tmp/dnsmasq.cfg*.d
	do
		[ -n "${dir}" ] || continue
		IFS="${DEFAULT_IFS}"
		rm -f "${dir}/${CS_BASE_FNAME:-???}"* "${dir}/${BLOCKSET_BASE_FNAME:-???}"*
	done
	IFS="${DEFAULT_IFS}"

	restart_dnsmasq 4 # all dnsmasq instances

	:
}

# Env vars: FORCE_STOP
stop_blocksets()
{
	local set_id \
		stop_ok_ids='' \
		stop_fail_ids='' \
		stop_ids='' \
		stop_rv \
		curr_path \
		run_state \
		set_ids="${1}"

	[ -n "${set_ids}" ] || return 0

	for set_id in ${set_ids}
	do
		get_params "${set_id}" run_state || return 1
		[ "${run_state}" = 4 ] && [ -z "${FORCE_STOP}" ] &&
		{
			[ "${CUR_ACT}" = stop ] && reg_msg -fb "${set_id}" "Adblocking is already stopped{}."
			continue
		}
		add2list stop_ids "${set_id}" || return 1
	done

	[ -n "${stop_ids}" ] || return 0

	reg_action -1 -purple -fb "${stop_ids}" "" "Stopping adblocking{}."

	rm_conf_scripts "${stop_ids}"
	rm_blocksets "${stop_ids}"

	restart_dnsmasq 4 stop_ok_ids "${stop_ids}"
	stop_rv=${?}

	unset_metadata "${set_ids}"

	commit_metadata

	subtract_a_from_b "${stop_ok_ids}" "${stop_ids}" stop_fail_ids

	[ -n "${stop_ok_ids}" ] &&
		log_msg -fb "${stop_ok_ids}" "Successfully stopped adblocking{}."

	[ -n "${stop_fail_ids}" ] && reg_failure -fb "${stop_fail_ids}" "Failed to stop adblocking{}."
	return ${stop_rv}
}

restart()
{
	local CUR_ACT=restart
	local CUR_CMD=${CUR_ACT}
	init_act "${CUR_ACT}" &&
	KEEP_PERSIST=0 do_stop "${@}" &&
	start "${@}"
	exit ${?}
}

reload() { restart "${@}"; }

# return codes:
# 0 - adblock-lean blockset is loaded
# 1 - error
# 2 - adblock-lean is performing an action
# 3 - adblock-lean is paused
# 4 - adblock-lean is stopped
status()
{
	check_lock
	case ${?} in
		1) exit 1 ;;
		2)
			report_curr_action
			exit 2
	esac

	local CUR_ACT=status
	local CUR_CMD=${CUR_ACT}
	init_act "${CUR_ACT}" || exit 1

	rc_enabled
	case ${?} in
		0) print_msg -green "" "adblock-lean service is enabled." ;;
		1) print_msg -yellow "" "adblock-lean service is disabled."
	esac

	local timestamp curr_cnt_human \
		status_rv=0 \
		run_state curr_path curr_cnt persist_dir persist_mode \
		set_id set_id_pr \
		ASSERT_NOEXIT=1 \
		set_ids='' \
		set_ids_arg="${*:-"${SET_IDS}"}"

	[ -n "${set_ids_arg}" ] && get_valid_set_ids set_ids "${set_ids_arg}" || return 1

	set_global_env || status_rv=1

	if [ -z "${SET_IDS}" ]
	then
		reg_failure "No blockset configs found."
		status_rv=1
	elif [ -z "${set_ids}" ]
	then
		reg_failure "No valid blockset IDs specified."
		status_rv=1
	elif ! set_blocksets_env "${set_ids}"
	then
		reg_failure -fb "${set_ids}" "Failed to load environment{}."
		status_rv=1
	else
		for set_id in ${set_ids}
		do
			run_state=1
			set_id_pr="blockset ${lblue}${set_id}${n_c}"
			print_msg "" "Status of ${set_id_pr}:"
			get_params "${set_id}" run_state curr_path curr_cnt persist_dir persist_mode &&
			{
				: "${curr_cnt:=0}"
				case "${run_state}" in 0|3)
					[ -n "${curr_path}" ] || run_state=1
					[ "${curr_cnt}" -gt 0 ] ||
					{
						log_msg -warn "  Blockset file for ${set_id_pr} not found or no entries found in the blockset file."
						run_state=1
					}
				esac

				case "${run_state}" in 0|3)
					int2human curr_cnt_human "${curr_cnt}" || return 1
					timestamp="$(get_blockset_timestamp -h "${set_id}")"
					print_msg \
						"  Blockset file: ${blue}${curr_path}${n_c}" \
						"  Entries count: ${blue}${curr_cnt_human}${n_c}" \
						"  Timestamp: ${blue}${timestamp:-"${red}Unknown"}${n_c}"

					[ -n "${persist_dir}" ] && [ "${persist_mode}" = managed ] && [ "${curr_path%/*}" != "${persist_dir}" ] &&
						print_msg -warn "Persistent blockset directory '${persist_dir}' for ${set_id_pr} is configured but not currently used."
				esac

				case ${run_state} in
					0) print_msg -green  "  Adblocking is active.";;
					3) print_msg -orange "  Adblocking is paused." ;;
					4) print_msg -yellow "  Adblocking is stopped." ;;
					*)
						run_state=1
						reg_failure "Blockset '${set_id}' is not working correctly. Consider running 'service adblock-lean restart ${set_id}' in order to restore adblocking." ;;
				esac

			}

			luci_good_entries=${curr_cnt:-0}
			luci_dnsmasq_status=${run_state}
			[ "${run_state}" = 1 ] && status_rv=1
		done
	fi

	check_for_updates
	luci_update_status=${?}

	exit ${status_rv}
}

# 1: pause|resume
# additional args: blockset IDs
pause_resume()
{
	do_bail()
	{
		case "${1}" in
			pause)
				stop_blocksets "${2}" ;;
			resume)
				rm_conf_scripts "${2}"
				rm_blocksets "${2}"
				unset_param_vars "${2}"
		esac
	}

	local cmd="${1:?}"
	local CUR_ACT="${cmd}" CUR_CMD="${cmd}"
	shift
	init_act "${CUR_ACT}" || exit 1

	local \
		set_ids='' \
		ok_ids='' \
		prep_ok_ids='' \
		prep_fail_ids='' \
		act_ok_ids='' \
		act_fail_ids='' \
		\
		set_id set_id_pr \
		run_state \
		curr_path \
		curr_cnt \
		install_path \
		install_1_instance \
		pause_path \
		state_ok_pr \
		state_ok_msg \
		state_changed_pr \
		state_progr_pr \
		dnsmasq_indexes='' \
		FAIL_STOP_REQ=1 \
		final_compr_to_file \
		set_ids_arg="${*:-"${SET_IDS?}"}"

	[ -n "${set_ids_arg}" ] && get_valid_set_ids set_ids "${set_ids_arg}" || return 1
	[ -n "${set_ids}" ] || exit 0

	set_all_env "${set_ids}" || exit 1

	case "${cmd}" in
		pause)
			state_ok_pr="already paused"
			state_changed_pr=paused
			state_progr_pr=Pausing ;;
		resume)
			state_ok_pr="not paused"
			state_changed_pr=resumed
			state_progr_pr=Resuming
	esac

	printf '\n' > "${MSGS_DEST}"

	for set_id in ${set_ids}
	do
		get_params -f "${cmd}" "${set_id}" run_state || return 1

		set_id_pr="blockset ${lblue}${set_id}${n_c}"

		case "${run_state}" in
			0|3|4) ;;
			*)
				reg_failure "Run state of blockset '${set_id}' is '${run_state}'."
				add2list prep_fail_ids
				continue
		esac

		case "${cmd},${run_state}" in
			"pause,3"|"resume,0") state_ok_msg="Adblocking is ${state_ok_pr}{}."  ;;
			"pause,4"|"resume,4") state_ok_msg="${yellow}Adblocking is stopped{}. Can not ${cmd}.${n_c}" ;;
			*) false
		esac &&
		{
			reg_msg -fb "${set_id}" "${state_ok_msg}"
			add2list ok_ids "${set_id}"
			continue
		}

		reg_msg -fb "${set_id}" "Preparing to ${cmd} adblocking{}."

		get_params -f "${cmd}" "${set_id}" \
			curr_path \
			curr_cnt \
			pause_path \
			install_path &&
		get_params "${set_id}" final_compr_to_file install_1_instance || return 1

		case "${cmd}" in
			pause)
				rm_conf_scripts "${set_id}" &&
				mv_blockset "${curr_path}" "${pause_path}" "${final_compr_to_file}" "${set_id}" ;;
			resume)
				mv_blockset "${curr_path}" "${install_path}" "${final_compr_to_file}" "${set_id}" &&
				set_params "${set_id}" "install_cnt=${curr_cnt}" ;;
		esac &&
		set_params "${set_id}" curr_single_instance="${install_1_instance}" ||
		{
			add2list prep_fail_ids
			continue
		}

		add2list prep_ok_ids "${set_id}"
	done

	[ -n "${prep_fail_ids}" ] &&
	{
		reg_failure -fb "${prep_fail_ids}" "Failed to ${cmd} adblocking{}."
		ASSERT_NOEXIT=1 KEEP_BK=0 KEEP_PERSIST=0 stop_blocksets "${prep_fail_ids}"
	}

	[ -n "${prep_ok_ids}" ] &&
	{
		reg_action -purple -fb "${prep_ok_ids}" "" "${state_progr_pr} adblocking{}."

		case "${cmd}" in
			pause) restart_dnsmasq 3 act_ok_ids "${prep_ok_ids}" ;;
			resume) install_blocksets act_ok_ids _ "${prep_ok_ids}" ;;
		esac

		[ -n "${act_ok_ids}" ] &&
			log_msg -green -fb "${act_ok_ids}" "" "Successfully ${state_changed_pr} adblocking{}."

		add2list ok_ids "${act_ok_ids}"

		subtract_a_from_b "${act_ok_ids}" "${prep_ok_ids}" act_fail_ids
		[ -n "${act_fail_ids}" ] &&
		{
			reg_failure -fb "${act_fail_ids}" "Failed to ${cmd} adblocking{}."
			ASSERT_NOEXIT=1 KEEP_BK=0 KEEP_PERSIST=0 do_bail "${cmd}" "${act_fail_ids}"
		}
	}

	commit_metadata

	[ -n "${ok_ids}" ]
}

# 1 (optional): blockset IDs - defaults to all IDs
pause() { pause_resume pause "${@}"; exit ${?}; }

# 1 (optional): blockset IDs - defaults to all IDs
resume() { pause_resume resume "${@}"; exit ${?}; }

# optional: '-s <path>' to simulate update (intended for testing: service adblock-lean update -s <path_to_new_ver> -v <version>)
# optional: -v [release|snapshot|<version>|branch=<github_branch>|commit=<commit_hash>]
# optional: '-f' to skip calling do_stop()
update()
{
	# unset vars and functions from current version to have a clean slate with the new version
	clean_abl_env()
	{
		local set_id
		check_func unset_param_vars && unset_param_vars "${SET_IDS}"
		for set_id in ${SET_IDS}
		do
			unset "BL_ENV_SET_${set_id}"
		done
		unset action ABL_INIT_ACT ABL_CMD CUR_CMD CUR_ACT ABL_LIB_FILES ABL_EXTRA_FILES ABL_EXEC_FILES LIBS_SOURCED CONFIG_FORMAT CONFIG_LOADED BL_PARAMS_MAP VAR2CFG_MAP SET_IDS GLOBAL_ENV_SET SKIP_SET_ENV MAIN_UTILS_DETECTED
		unset -f abl_post_update_1 abl_post_update_2 load_config update source_libs check_libs install_abl_files cleanup_and_exit
	}

	upd_failed()
	{
		local fail_msg="${1}"
		[ -s "${UCL_ERR_FILE}" ] && fail_msg="${fail_msg} uclient-fetch errors: '$(cat "${UCL_ERR_FILE}")'"
		[ -n "${fail_msg}" ] && reg_failure "${fail_msg}"
		reg_failure "Failed to update adblock-lean."
		rm -rf "${ABL_UPD_DIR:-???}" "${ABL_PID_DIR:-???}" "${UCL_ERR_FILE:-???}"
	}

	unexp_arg() { upd_failed "update: unexpected argument '${1}'."; }

	local file req_ver='' ver_str_arg='' ver_type='' dist_dir='' upd_ver='' tarball_url='' \
		upd_channel='' req_upd_channel='' force_upd_channel='' upd_nostop=''
	local CUR_ACT=update
	local CUR_CMD=${CUR_ACT}

	IGNORE_CACHE=
	while getopts ":s:v:U:W:yfi" opt
	do
		case ${opt} in
			s) export sim_path="$OPTARG" ;;
			v) ver_str_arg=$OPTARG ;;
			U) force_upd_channel=$OPTARG ;;
			W) req_ver=$OPTARG ;;
			f) upd_nostop=1 ;;
			y) export APPROVE_UPD_CHANGES=1 DO_DIALOGS=0 ;;
			i) IGNORE_CACHE=1 ;; # global var
			*) unexp_arg "$OPTARG"; return 1
		esac
	done
	shift $((OPTIND-1))
	[ -z "${*}" ] || { unexp_arg "${*}"; return 1; }

	init_act "${CUR_ACT}" || { upd_failed; return 1; }

	[ -n "${upd_nostop}" ] || STOP_NOEXIT=1 stop ||
		{ log_msg "To force the update without calling the 'stop' command, use 'service adblock-lean stop -f'."; return 1; }

	# parse version string from arguments into $req_upd_channel, $req_ver
	case "${ver_str_arg}" in
		'') ;;
		release|latest)
			req_upd_channel=release req_ver='' ;;
		snapshot)
			req_upd_channel="${ver_str_arg}" req_ver='' ;;
		commit=*)
			req_upd_channel="${ver_str_arg}" req_ver="${ver_str_arg#*=}" ;;
		branch=*)
			req_upd_channel="${ver_str_arg}" req_ver='' ;;
		[0-9]*|v[0-9]*)
			req_upd_channel=release
			req_ver="${ver_str_arg#*=}"
			req_ver="${req_ver#v}"
			;;
		*)
			upd_failed "Invalid version string '${ver_str_arg}'."
			return 1
	esac

	rm -rf "${ABL_UPD_DIR:-???}"
	try_mkdir -p "${ABL_UPD_DIR}" || { upd_failed; return 1; }

	upd_channel="${req_upd_channel:-"${ABL_UPD_CHANNEL}"}"
	upd_channel="${force_upd_channel:-"${upd_channel}"}"
	upd_channel="${upd_channel:-"release"}"

	dist_dir="${ABL_UPD_DIR}/dist"
	try_mkdir -p "${dist_dir}" || { upd_failed; return 1; }

	if [ -n "${sim_path}" ]
	then
		print_msg -yellow "Updating in simulation mode."
		[ -d "${sim_path}" ] || { upd_failed "Update simulation directory '${sim_path}' does not exist."; return 1; }
		[ -n "${ver_str_arg}" ] || { upd_failed "Specify new version string."; return 1; }
		upd_ver="${ver_str_arg}"

		[ -d "${sim_path}" ] || { upd_failed "Simulation source directory doesn't exist."; return 1; }
		cp -rT "${sim_path}" "${dist_dir}"
		log_msg "" "Updating adblock-lean to version '${upd_ver}' (update channel: '${upd_channel}')."
	else
		get_gh_ref "${upd_channel}" "${req_ver}" upd_ver tarball_url ver_type || { upd_failed; return 1; }
		case "${upd_channel}" in
			commit=*)
				# set update channel to 'commit=<full_commit_hash>'
				upd_channel="${upd_channel%=*}=${upd_ver}"
		esac
		log_msg "" "Downloading adblock-lean, ${ver_type} '${upd_ver}' (update channel: '${upd_channel}')."
		fetch_abl_dist "${tarball_url}" "${dist_dir}" || { upd_failed; return 1; }
	fi

	# Call install_abl_files() from fetched installer
	grep -m1 -q '[ 	]*install_abl_files()' "${dist_dir}/abl-install.sh" ||
		inst_failed "Downloaded adblock-lean install script does not define the function 'install_abl_files' - try a newer adblock-lean version."
	(
		clean_abl_env
		INST_SOURCED=1 . "${dist_dir}/abl-install.sh" ||
			{ reg_failure "Failed to source fetched install script."; exit 1; }
		check_func install_abl_files &&
		install_abl_files "${dist_dir}" "${upd_ver}" "${upd_channel}"
	) ||
		{ reg_failure "Failed to update adblock-lean."; exit 1; }

	log_msg -green "" "adblock-lean has been updated to version '${upd_ver}'."


	local cur_main_cfg_path='' cur_blockset_cfg_files='' cfg_found=''

	{
		[ -s "${GLOBAL_CFG_FILE}" ] &&
		cur_main_cfg_path="${GLOBAL_CFG_FILE}"
	} ||
	{
		[ -s "${LEGACY_CFG_FILE}" ] &&
		cur_main_cfg_path="${LEGACY_CFG_FILE}"
	}

	find_set_configs cur_blockset_cfg_files

	[ "${cur_main_cfg_path}" = "${LEGACY_CFG_FILE}" ] ||
	{ [ "${cur_main_cfg_path}" = "${GLOBAL_CFG_FILE}" ] && [ -n "${cur_blockset_cfg_files}" ]; } &&
		cfg_found=1

	if [ -n "${cfg_found}" ]
	then
		if [ "${DO_DIALOGS}" = 1 ]
		then
			print_msg -blue "" "Start adblock-lean now? (y|n)"
			pick_opt "y|n"
		else
			REPLY=y
		fi

		[ "${REPLY}" = y ] || exit 0

		clean_abl_env
		. "${ABL_SERVICE_PATH}" || return 1
		start
		exit ${?}
	elif \
		[ -n "${DO_DIALOGS}" ] &&
		print_msg -blue "" "Set up adblock-lean now? (y|n)" &&
		pick_opt "y|n" &&
		[ "$REPLY" = y ]
	then
		clean_abl_env
		set +o pipefail # for compatibility with older versions
		# shellcheck source=/dev/null
		. "${ABL_SERVICE_PATH}"
		setup
		exit ${?}
	else
		log_msg -yellow "adblock-lean config is not found. Please use the command 'service adblock-lean setup' to set up adblock-lean."
		exit 0
	fi
}

uninstall()
{
	local ASSERT_NOEXIT=1
	local CUR_ACT=uninstall
	local CUR_CMD=${CUR_ACT}
	init_act "${CUR_ACT}" || return 1
	KEEP_PERSIST=0 do_stop
	if rc_enabled
		then
		log_msg "Disabling adblock-lean."
		rc_disable && ! rc_enabled ||
			{ reg_failure "Failed to disable adblock-lean. Disable manually and then run this command again."; exit 1; }
	fi

	rm_cron_job

	if [ "${DO_DIALOGS}" = 1 ]
	then
		print_msg "" "Delete the config directory ${ABL_CFG_DIR}? (y|n)"
		pick_opt "y|n"
	else
		REPLY="${luci_uninstall_rm_config:-n}"
	fi

	if [ "${REPLY}" = y ]
	then
		print_msg "Deleting the config directory."
		rm -rf "${ABL_CFG_DIR:-???}"
	fi

	local i="-1" addnm_deleted='' addnm_del_fail=''
	while [ ${i} -lt 128 ]
	do
		i=$((i+1))
		uci -q get dhcp.@dnsmasq[${i}] >/dev/null || break
		del_addnmounts "${i}"
		case ${?} in
			0) addnm_deleted=1 ;;
			3) ;;
			1) addnm_del_fail=1 ;;
			2) addnm_deleted=1 addnm_del_fail=1
		esac
	done

	if [ -n "${addnm_deleted}" ]
	then
		if uci commit dhcp
		then
			print_msg "Note: the adblock-lean developers are not aware of any other software that requires the specific addnmount entry created by adblock-lean." \
				"Should the addnmount entry be required for any reason then you will need to manually re-add it."
		else
			uci revert dhcp
			addnm_del_fail=1
		fi
	fi

	[ -n "${addnm_del_fail}" ] && log_msg -warn "Some addnmount entries in /etc/config/dhcp were not deleted. Please delete manually."

	print_msg "Deleting the adblock-lean hotplug script."
	rm -f "${ABL_HOTPLUG_PATH_ENABLED}" "${ABL_HOTPLUG_PATH_DISABLED}"

	print_msg "Deleting adblock-lean scripts."
	rm -f "${ABL_SERVICE_PATH}"
	rm -rf "${ABL_LIB_DIR:-???}" "${ABL_RUN_DIR:-???}" "${ABL_TMP_DIR:-???}"

	print_msg "" "Uninstall complete."
	exit 0
}

enable()
{
	local CUR_ACT=enable
	local CUR_CMD=${CUR_ACT}
	init_act "${CUR_ACT}" || return 1
	if rc_enabled
	then
		reg_msg -green "The adblock-lean service is already enabled."
		return 0
	fi
	rc_enable && rc_enabled ||
		{ reg_failure "Failed to enable the adblock-lean service"; return 4; }
	source_libs && load_config || return 3
	[ -n "${upd_schedule}" ] && { upd_cron_job || return 6; }
	:
}

disable()
{
	local CUR_ACT=disable
	local CUR_CMD=${CUR_ACT}
	init_act "${CUR_ACT}" || return 1
	local rv=0
	if rc_enabled
	then
		rm_cron_job
		rc_disable && ! rc_enabled ||
			{ reg_failure "Failed to disable the adblock-lean service"; local rv=1; }
		do_stop
	else
		reg_msg "The adblock-lean service is already disabled."
	fi
	return "${rv}"
}

