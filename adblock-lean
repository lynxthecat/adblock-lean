### UTILITY FUNCTIONS

is_hex_lc() { case "${1}" in ''|*[!0-9a-f]*) false ;; *) :; esac; }

is_uint()
{
	local _v
	for _v in "${@}"
	do
		case "${_v}" in
			''|*[!0-9]*) return 1
		esac
	done
	:
}

is_alphanum()
{
	local _v
	for _v in "${@}"
	do
		case "${_v}" in
			''|*[!a-zA-Z0-9_]*) return 1
		esac
	done
	:
}

# Env vars:
#   ASSERT_NOEXIT: do not exit on error
# Check that required vars are set
# Use only for runtime code integrity validation
# 1: asserting function name, prefixed with 'F_'
# extra args: variable names which must have a value
assert_set()
{
	assert_fail()
	{
		[ -n "${1}" ] && reg_failure "${1}"
		[ -n "${ASSERT_NOEXIT}" ] || exit 1
	}

	local me=assert_set func _val_ne _var_ne _checked='' IFS="${DEFAULT_IFS}"

	case "${1}" in
		F_*)
			func="${1#"F_"}"
			case "${func}" in
				'') false ;;
			esac ;;
		*) false
	esac || { assert_fail "${me}: func '${1}' not prefixed with 'F_'"; return 1; }

	shift

	for _var_ne in "${@}"
	do
		[ -n "${_var_ne}" ] || { assert_fail "${me}: func '${1}()': var name can not be empty string."; return 1; }
		eval "_val_ne=\"\${${_var_ne}}\""
		case "${_val_ne}" in
			'') assert_fail "Assertion failed: ${func}(): variable '${_var_ne}' must have a value."; return 1 ;;
			*) _checked=1; continue
		esac
	done

	case "${_checked}" in '') assert_fail "${me}: no vars specified by ${func}()"; return 1; esac

	:
}

bad_args()
{
	local arg args func="${1}"
	shift
	for arg in "${@}"
	do
		args="${args}${args:+", "}'${arg}'"
	done
	reg_failure "${func}: bad args: ${args}"
}

unset_vars()
{
	are_var_names_safe "${@}" || return 1
	local var
	for var in "${@}"
	do
		[ -n "${var}" ] && export -n "${var}="
	done
	:
}

# check if var names are safe to use with eval
are_var_names_safe() {
	local var_name
	for var_name in "${@}"
	do
		case "${var_name}" in [!a-zA-Z_]*|*[!a-zA-Z0-9_]*) reg_failure "Invalid var name '${var_name}'."; return 1; esac
	done
	:
}

# Env vars:
#   FF_RM_EXTRA: remove 2nd and further found files
#   FF_FIRST: return only the first found file
#   FF_EXEC=<cmd>: execute command for each found and processed file. '{}' in <cmd> is replaced with path to file.
# Args:
#   1: var name for newline-separated paths output
#   2: dir
#   3: filename prefix
#   4: filename mid
#   5: filename suffix
#   6 (optional): set ID
find_files()
{
	local me=find_files exec='' ff_file ff_found='' \
		ff_path_out_var="${1}" ff_dir="${2}" ff_prefix="${3}" ff_mid="${4}" ff_suffix="${5}" set_id="${6}"

	unset_vars "${ff_path_out_var}" || return 1

	[ -n "${FF_EXEC}" ] && { check_util "${FF_EXEC%% *}" || { reg_failure "${me}: invalid exec cmd '${FF_EXEC}'"; return 1; }; }

	# shellcheck disable=SC2027
	for ff_file in "${ff_dir}/${ff_prefix}"${ff_mid}"${ff_suffix}"
	do
		case "${ff_file}" in
			''|*"*"*) continue ;;
			[\$\(\)\{\}\"\`\'] ) reg_msg -warn "${me}: path '${ff_file}' contains unsupported characters. Ignoring the file."; continue
		esac
		[ -f "${ff_file}" ] || continue # ignore dirs and symlinks
		[ -n "${ff_found}" ] && [ -n "${FF_RM_EXTRA}" ] &&
			{ [ -n "${set_id}" ] && rm_if_writable "${set_id}" "${ff_file}"; continue; }

		[ -n "${FF_EXEC}" ] &&
		{
			exec="${FF_EXEC//"{}"/"\"${ff_file}\""}"
			eval "${exec}" || { reg_failure "${me}: '${exec}' returned code ${?}"; return 1; }
		}

		ff_found="${ff_found}${ff_found:+"${_NL_}"}${ff_file}"

		[ -n "${FF_FIRST}" ] && [ -z "${FF_RM_EXTRA}" ] && break
	done

	[ -n "${ff_found}" ] || return 2

	export -n "${ff_path_out_var:-_}=${ff_found}" || return 1
	:
}

check_func()
{
	check_util "${1}" && [ "$(type "${1}" 2>/dev/null | head -n1)" = "${1} is a function" ]
