### MAIN COMMAND FUNCTIONS

version()
{
	print_msg "adblock-lean version: '${ABL_VERSION}', update channel: '${ABL_UPD_CHANNEL}'."
}

gen_config()
{
	init_command gen_config &&
	do_gen_config
}

setup()
{
	# set luci feedback vars to failed, unset later upon success
	luci_pkgs_install_failed=1 luci_cron_job_creation_failed=1

	init_command setup &&
	do_setup
}

print_log()
{
	[ -s "${ABL_SESSION_LOG_FILE}" ] ||
		{ print_msg -err "Session log file '${ABL_SESSION_LOG_FILE}' doesn't exist or is empty."; exit 1; }
	printf '%s\n' "Most recent session log:"
	cat "${ABL_SESSION_LOG_FILE}"
	:
}

upd_cron_job()
{
	local me="upd_cron_job" curr_cron cron_line

	log_msg -purple "" "Updating cron job for adblock-lean."

	init_command upd_cron_job || return 1

	case "${cron_schedule}" in
		'') reg_failure "${me}: the \$cron_schedule variable is unset."; return 1 ;;
		disable)
			reg_msg -3 -yellow "cron_schedule is set to 'disable' in config."
			rm_cron_job
			return 0
	esac

	enable_cron_service || return 1
	curr_cron="$(get_curr_crontab)"
	case ${?} in
		0) print_msg -green "Cron job for adblock-lean with schedule '${cron_schedule}' aldready exists."; return 0 ;;
		1) return 1 ;;
		2) curr_cron="$(printf %s "${curr_cron}" | $SED_CMD "s~^.*${ABL_CRON_CMD}.*\$~~")" ;; # remove cron job with a different schedule
		3) ;; # no adblock-lean cron job exists
	esac

	cron_line="${cron_schedule} RANDOM_DELAY=1 ${ABL_CRON_CMD} 1>/dev/null"

	#### Create new cron job
	print_msg "Creating cron job with schedule '${blue}${cron_schedule}${n_c}'."
	printf '%s\n' "${curr_cron}${_NL_}${cron_line}" | $SED_CMD '/^$/d' | crontab -u root - ||
		{ reg_failure "Failed to update crontab."; return 1; }
	:
}

select_dnsmasq_instances()
{
	init_command select_dnsmasq_instances &&
	do_select_dnsmasq_instances "${@}" || return 1

	local all_req_addnmounts missing_addnmounts
	CPF_QUIET=1 check_process_features _ all_req_addnmounts missing_addnmounts &&
	suggest_addnmounts "${all_req_addnmounts}" "${missing_addnmounts}" || return 1

}

# 1 - (optional) '-noexit' to return to the calling function
gen_stats()
{
	source_libs &&
	reg_action -3 -blue "" "Generating dnsmasq stats." || exit 1
	local dnsmasq_pid
	dnsmasq_pid="$(pidof /usr/sbin/dnsmasq)" || { reg_failure "Failed to detect dnsmasq PID or dnsmasq is not running."; exit 1; }
	kill -USR1 "${dnsmasq_pid}"
	print_msg "dnsmasq stats available for reading using 'logread'."
	[ "${1}" != '-noexit' ] && exit 0
	:
}

boot()
{
	init_command boot || exit 1
	[ "${boot_start_delay_s}" -gt 0 ] &&
	{
		reg_action -1 -purple "Sleeping for ${boot_start_delay_s} seconds."
		sleep "${boot_start_delay_s}" &
		wait ${!}
	}
	start "$@"
}

start()
{
	init_command start || exit 1

	if ! dnsmasq --help | grep -qe "--conf-script"
	then
		reg_failure "The version of dnsmasq installed on this system is too old." \
			"To use adblock-lean, upgrade this system to OpenWrt 23.05 or later."
		exit 1
	fi

	if [ "${RANDOM_DELAY}" = "1" ]
	then
		random_delay_mins=$(($(hexdump -n 1 -e '"%u"' </dev/urandom)%60))
		reg_action -1 -purple "Delaying automatic lists update by ${random_delay_mins} minutes (thundering herd prevention)." || exit 1
		sleep "${random_delay_mins}m" &
		wait ${!}
	fi

	case "${START_ACTION}" in
		load|gen) ;;
		*) reg_failure "Unexpected start action '${START_ACTION}'."; exit 1
	esac

	local run_state entries_cnt conn_check_req=1 rv=1 initial_uptime_ms elapsed_time totalmem restore_from_persist=''

	get_uptime_ms initial_uptime_ms

	FAIL_STOP_REQ=1

	rm_pause_bl
	rm_conf_scripts
	[ -n "${BL_FILE_CURR}" ] || rm_main_bl

	if [ "${START_ACTION}" = load ]
	then
		assert_set F_start BL_FILE_NEW || exit 1

		[ -z "${BL_FILE_CURR}" ] || [ "${BL_FILE_CURR}" = "${LOAD_BL_PATH}" ] || rm_main_bl

		if stop_dnsmasq &&
			install_blocklist "${LOAD_BL_PATH}" "${LOAD_BL_ENTRIES_CNT}" "${LOAD_BL_DESC}"
		then
			rv=0
		else
			reg_failure "Failed to install blocklist '${LOAD_BL_PATH}'"
			[ -n "${BL_FILE_NEW_FALLBACK}" ] && [ -d "${BL_FILE_NEW_FALLBACK%/*}" ] || return 1

			BL_FILE_NEW=${BL_FILE_NEW_FALLBACK}
			export CONF_FILES_REQ="${CONF_FILES_REQ_FALLBACK}"
			log_msg "Will try to generate a new blocklist."
			stop 1 -noexit
			START_ACTION=gen
		fi
	fi

	if [ "${START_ACTION}" = gen ]
	then

		get_abl_run_state run_state
		case "${run_state}" in
			0) ;;
			1) stop 1 -noexit; get_abl_run_state run_state ;;
			3) reg_msg -3 -purple "" "adblock-lean is currently paused. "; resume ;;
			4) ;;
			*) inval_run_state "${run_state}" "start"; exit 1
		esac

		case ${run_state} in
			1) unload_blocklist_before_update=1 ;;
			3|4) unload_blocklist_before_update=0 conn_check_req='' ;;
		esac

		if [ "${unload_blocklist_before_update}" = auto ]
		then
			read -r _ totalmem _ < /proc/meminfo
			if is_uint "${totalmem}" && [ "${totalmem}" -ge 410000 ]
			then
				unload_blocklist_before_update=0
			else
				unload_blocklist_before_update=1
			fi
		fi

		if [ "${unload_blocklist_before_update}" != 1 ] && [ -n "${conn_check_req}" ]
		then
			reg_action -3 -blue "Testing connectivity." || exit 1
			test_url_domains || unload_blocklist_before_update=1
		fi

		if [ -n "${BL_FILE_CURR}" ]
		then
			if is_dir_volatile "${BL_FILE_CURR%/*}"
			then
				export_blocklist "${BL_FILE_CURR}" "${BK_BL_FILE}" "${INTERM_COMPR_TO_FILE}"
			elif [ -f "${BL_FILE_CURR}" ]
			then
				BK_BL_FILE=${BL_FILE_CURR}
				restore_from_persist=1 # for persistent blocklist in 'manual' mode, the original file is used as a backup
			fi
		else
			log_msg "" "No existing blocklist found."
		fi

		rm_conf_scripts
		rm_main_bl

		if [ "${unload_blocklist_before_update}" = 1 ]
		then
			reg_action -3 -blue "Unloading current blocklist."
			restart_dnsmasq || exit 1
		fi

		assert_set F_start BL_FILE_NEW || return 1

		processed_bl_file="${ABL_TMP_DIR}/${PROCESSED_BL_BASE_FNAME:?}${FINAL_COMPR_EXT}"

		if gen_blocklist entries_cnt "${processed_bl_file}" "${initial_uptime_ms}" &&
			stop_dnsmasq &&
			conv_compr "${processed_bl_file}" "${BL_FILE_NEW}" "${FINAL_COMPR_TO_FILE}" &&
			install_blocklist "${BL_FILE_NEW}" "${entries_cnt}" "processed"
		then
			[ "${BL_FILE_NEW%/*}" = "${PERSIST_BLOCKLIST_DIR}" ] && mk_blocklist_md5 "${BL_FILE_NEW}"
			rv=0
		else
			reg_failure "Failed to generate new blocklist."
			local restore_failed=1
			if [ -f "${BK_BL_FILE}" ]
			then
				[ -n "${restore_from_persist}" ] && BL_FILE_NEW="${BK_BL_FILE}"
				if restore_saved_blocklist "${BK_BL_FILE}" "${BL_FILE_NEW}"
				then
					if CA_CHECK_DNS=1 check_active_blocklist -new
					then
						log_msg -green "Previous blocklist restored successfully."
						restore_failed=
					else
						reg_failure "Active blocklist check failed with previous blocklist file."
					fi
				else
					reg_failure "Failed to restore blocklist file '${BK_BL_FILE}'."
				fi
			else
				log_msg -yellow "" "Previous blocklist file does not exist - can not restore."
			fi
			[ -n "${restore_failed}" ] && stop 1 -noexit
		fi
	fi

	[ -n "${restore_from_persist}" ] || rm -f "${BK_BL_FILE}"

	[ "${rv}" = 0 ] &&
	{
		get_elapsed_time_human elapsed_time "${initial_uptime_ms}"
		reg_msg -3 "" "Processing time for blocklist generation and import: ${blue}${elapsed_time:-"${yellow}unknown"}${n_c}"
	}

	FAIL_STOP_REQ=

	check_for_updates
	exit ${rv}
}

# 1 - (optional) exit code
# 1/2 - (optional) '-noexit' to return to the calling function
stop()
{
	local file dir stop_rc=0 ASSERT_NOEXIT=1 KEEP_PERSIST=1 noexit=
	for _arg in "$@"
	do
		case "${_arg}" in
			"-noexit") noexit=1 ;;
			*[!0-9]*|'') ;;
			*) stop_rc="${_arg}"
		esac
	done
	msg="${msg% }"

	init_command stop || { FAIL_STOP_REQ=''; exit 1; }
	load_config

	get_curr_blocklist_paths

	reg_msg -3 -blue "" "Unloading blocklist and removing any adblock-lean blocklist files."

	rm_conf_scripts || stop_rc=1
	rm_pause_bl
	rm_main_bl

	restart_dnsmasq -nostop || stop_rc=1

	rm -f "${MAC_SHARED_FILE}"

	log_msg -purple "" "Stopped adblock-lean." || stop_rc=1

	[ -n "${noexit}" ] && return "${stop_rc}"

	FAIL_STOP_REQ=
	exit "${stop_rc}"
}

restart()
{
	init_command restart || exit 1
	stop -noexit || exit 1
	start
}

reload()
{
	restart
}

# return codes:
# 0 - adblock-lean blocklist is loaded
# 1 - error
# 2 - adblock-lean is performing an action
# 3 - adblock-lean is paused
# 4 - adblock-lean is stopped
status()
{
	check_lock
	case ${?} in
		1) exit 1 ;;
		2)
			report_curr_action
			exit 2
	esac

	rc_enabled
	case ${?} in
		0) print_msg -green "" "adblock-lean service is enabled." ;;
		1) print_msg -yellow "" "adblock-lean service is disabled."
	esac

	SAE_STATUS=1 init_command status || exit 1

	local run_state active_entries_cnt=0 timestamp active_entries_cnt_human

	get_abl_run_state run_state
	case ${run_state} in
		0) ;;
		1) reg_failure "adblock-lean is not working correctly. Consider running 'service adblock-lean restart' in order to restore adblocking." ;;
		3) print_msg -yellow "" "adblock-lean is paused." ;;
		4) print_msg -yellow "" "adblock-lean is stopped." ;;
		*) inval_run_state "${run_state}" "status"
	esac

	if [ "${run_state}" = 0 ]
	then
		if get_active_entries_cnt active_entries_cnt "${BL_FILE_CURR}" && [ "${active_entries_cnt}" != 0 ]
		then
			luci_good_line_count=${active_entries_cnt}
			int2human active_entries_cnt_human "${active_entries_cnt}" || return 1
			timestamp="$(get_blocklist_timestamp -h)"
			print_msg "" \
				"${green}adblock-lean is active.${n_c}" \
				"Installed blocklist file: ${blue}${BL_FILE_CURR}${n_c}" \
				"Entries count: ${blue}${active_entries_cnt_human}${n_c}" \
				"Blocklist was updated on: ${blue}${timestamp:-"${red}Unknown"}${n_c}"
			gen_stats -noexit
		else
			log_msg -warn "No entries found in the blocklist file."
			run_state=1
		fi
	fi

	[ -n "${PERSIST_BLOCKLIST_DIR}" ] && [ "${PERSIST_BLOCKLIST_MODE}" = managed ] && [ -n "${BL_FILE_CURR}" ] && [ "${BL_FILE_CURR%/*}" != "${PERSIST_BLOCKLIST_DIR}" ] &&
		print_msg -warn "" "Persistent blocklist directory is configured but not currently used."

	luci_dnsmasq_status=${run_state}

	check_for_updates
	luci_update_status=${?}

	exit "${run_state}"
}

pause()
{
	local run_state
	init_command pause || exit 1
	get_abl_run_state run_state
	case "${run_state}" in
		0) ;;
		1) stop 1 ;;
		3) reg_msg -3 -green "adblock-lean is already paused."; exit 0 ;;
		4) reg_msg -3 -err "adblock-lean is currently stopped."; exit 1 ;;
		*) inval_run_state "${run_state}" "pause"; exit 1
	esac

	local FAIL_STOP_REQ=1
	export_blocklist "${BL_FILE_CURR}" "${PAUSE_FILE_NEW}" "${FINAL_COMPR_TO_FILE}" || exit 1
	printf '%s\n' "${PAUSE_FILE_NEW}" > "${LAST_PAUSE_PATH_FILE}"
	mk_blocklist_md5 "${PAUSE_FILE_NEW}"
	rm_conf_scripts
	rm_main_bl
	restart_dnsmasq || exit 1
	FAIL_STOP_REQ=
	log_msg -purple "" "adblock-lean is now paused."
	exit 0
}

resume()
{
	local run_state
	init_command resume || exit 1
	get_abl_run_state run_state
	case "${run_state}" in
		0) reg_msg -3 -green "adblock-lean is already running."; exit 0 ;;
		1) stop 1 ;;
		3) ;;
		4) reg_msg -3 -err "adblock-lean is currently stopped, not paused. Can not resume."; exit 1 ;;
		*) inval_run_state "${run_state}" "resume"; exit 1
	esac

	FAIL_STOP_REQ=1
	restore_saved_blocklist "${PAUSE_FILE_CURR}" "${BL_FILE_NEW}" || stop 1
	rm -f "${LAST_PAUSE_PATH_FILE}"
	FAIL_STOP_REQ=
	log_msg -purple "" "adblock-lean is now resumed."
	exit 0
}

# optional: '-s <path>' to simulate update (intended for testing: service adblock-lean update -s <path_to_new_ver> -v <version>)
# optional: -v [release|snapshot|<version>|branch=<github_branch>|commit=<commit_hash>]
# optional: '-f' to skip calling stop()
update()
{
	downg_not_supported() { reg_failure "Downgrade to versions earlier than v0.7.3 is not supported."; return 1; }

	# unset vars and functions from current version to have a clean slate with the new version
	clean_abl_env()
	{
		unset action ABL_CMD ABL_LIB_FILES ABL_EXTRA_FILES ABL_EXEC_FILES LIBS_SOURCED CONFIG_FORMAT CONFIG_LOADED ABL_ENV_SET
		unset -f abl_post_update_1 abl_post_update_2 load_config update source_libs check_libs install_abl_files cleanup_and_exit
	}

	upd_failed()
	{
		local fail_msg="${1}"
		[ -s "${UCL_ERR_FILE}" ] && fail_msg="${fail_msg} uclient-fetch errors: '$(cat "${UCL_ERR_FILE}")'"
		[ -n "${fail_msg}" ] && reg_failure "${fail_msg}"
		reg_failure "Failed to update adblock-lean."
		rm -rf "${ABL_UPD_DIR:-???}" "${ABL_PID_DIR:-???}" "${UCL_ERR_FILE:-???}"
	}

	unexp_arg()
	{
		upd_failed "update: unexpected argument '${1}'."
	}

	local file req_ver='' ver_str_arg='' ver_type='' dist_dir='' upd_ver='' tarball_url='' \
		upd_channel='' req_upd_channel='' force_upd_channel='' upd_nostop=''

	IGNORE_CACHE=
	while getopts ":s:v:U:W:yfi" opt
	do
		case ${opt} in
			s) export sim_path="$OPTARG" ;;
			v) ver_str_arg=$OPTARG ;;
			U) force_upd_channel=$OPTARG ;;
			W) req_ver=$OPTARG ;;
			f) upd_nostop=1 libs_req='' ;;
			y) export APPROVE_UPD_CHANGES=1 DO_DIALOGS=0 ;;
			i) IGNORE_CACHE=1 ;; # global var
			*) unexp_arg "$OPTARG"; return 1
		esac
	done
	shift $((OPTIND-1))
	[ -z "${*}" ] || { unexp_arg "${*}"; return 1; }

	init_command update || { upd_failed; return 1; }

	[ -z "${upd_nostop}" ] && stop -noexit

	# parse version string from arguments into $req_upd_channel, $req_ver
	case "${ver_str_arg}" in
		'') ;;
		release|latest)
			req_upd_channel=release req_ver='' ;;
		snapshot)
			req_upd_channel="${ver_str_arg}" req_ver='' ;;
		commit=*)
			req_upd_channel="${ver_str_arg}" req_ver="${ver_str_arg#*=}" ;;
		branch=*)
			req_upd_channel="${ver_str_arg}" req_ver='' ;;
		[0-9]*|v[0-9]*)
			req_upd_channel=release
			req_ver="${ver_str_arg#*=}"
			req_ver="${req_ver#v}"
			;;
		*)
			upd_failed "Invalid version string '${ver_str_arg}'."
			return 1
	esac

	rm -rf "${ABL_UPD_DIR:-???}"
	try_mkdir -p "${ABL_UPD_DIR}" || { upd_failed; return 1; }

	upd_channel="${req_upd_channel:-"${ABL_UPD_CHANNEL}"}"
	upd_channel="${force_upd_channel:-"${upd_channel}"}"
	upd_channel="${upd_channel:-"release"}"

	dist_dir="${ABL_UPD_DIR}/dist"
	try_mkdir -p "${dist_dir}" || { upd_failed; return 1; }

	if [ -n "${sim_path}" ]
	then
		print_msg -yellow "Updating in simulation mode."
		[ -d "${sim_path}" ] || { upd_failed "Update simulation directory '${sim_path}' does not exist."; return 1; }
		[ -n "${ver_str_arg}" ] || { upd_failed "Specify new version string."; return 1; }
		upd_ver="${ver_str_arg}"

		[ -d "${sim_path}" ] || { upd_failed "Simulation source directory doesn't exist."; return 1; }
		cp -rT "${sim_path}" "${dist_dir}"
		log_msg "" "Updating adblock-lean to version '${upd_ver}' (update channel: '${upd_channel}')."
	else
		get_gh_ref "${upd_channel}" "${req_ver}" upd_ver tarball_url ver_type || { upd_failed; return 1; }
		case "${upd_channel}" in
			commit=*)
				# set update channel to 'commit=<full_commit_hash>'
				upd_channel="${upd_channel%=*}=${upd_ver}"
		esac
		log_msg "" "Downloading adblock-lean, ${ver_type} '${upd_ver}' (update channel: '${upd_channel}')."
		fetch_abl_dist "${tarball_url}" "${dist_dir}" || { upd_failed; return 1; }
	fi

	get_abl_version "${dist_dir}/adblock-lean"
	case "${?}" in
		2) downg_not_supported ;; # no version string found
		3) downg_not_supported ;; # old version format
		4) downg_not_supported ;; # v0.7.2
		5)
			# v0.7.3 or higher - call install_abl_files() from fetched installer
			(
				clean_abl_env
				INST_SOURCED=1 . "${dist_dir}/abl-install.sh" ||
					{ reg_failure "Failed to source fetched install script."; exit 1; }
				install_abl_files "${dist_dir}" "${upd_ver}" "${upd_channel}"
			) ;;
		*) reg_failure "Failed to get version from fetched adblock-lean distribution."; false ;;
	esac || exit 1

	log_msg -green "" "adblock-lean has been updated to version '${upd_ver}'."

	if [ "${DO_DIALOGS}" = 1 ]
	then
		print_msg "" "Start adblock-lean now? (y|n)"
		pick_opt "y|n"
	else
		REPLY=y
	fi

	if [ "${REPLY}" = y ]
	then
		clean_abl_env
		. "${ABL_SERVICE_PATH}" || return 1
		start
	else
		exit 0
	fi
}

uninstall()
{
	log_msg -purple "" "Uninstalling adblock-lean."
	stop -noexit
	if rc_enabled
		then
		log_msg -purple "" "Disabling adblock-lean."
		rc_disable && ! rc_enabled ||
			{ reg_failure "Failed to disable adblock-lean. Disable manually and then run this command again."; exit 1; }
	fi

	rm_cron_job

	if [ "${DO_DIALOGS}" = 1 ]
	then
		print_msg "" "Delete the config directory ${ABL_CONFIG_DIR}? (y|n)"
		pick_opt "y|n"
	else
		REPLY="${luci_uninstall_rm_config:-n}"
	fi

	if [ "${REPLY}" = y ]
	then
		print_msg -purple "" "Deleting the config directory."
		rm -rf "${ABL_CONFIG_DIR:-???}"
	fi

	local i="-1" addnm_deleted='' addnm_del_fail=''
	while [ ${i} -lt 128 ]
	do
		i=$((i+1))
		uci -q get dhcp.@dnsmasq[${i}] >/dev/null || break
		del_addnmounts "${i}"
		case ${?} in
			0) addnm_deleted=1 ;;
			3) ;;
			1) addnm_del_fail=1 ;;
			2) addnm_deleted=1 addnm_del_fail=1
		esac
	done

	if [ -n "${addnm_deleted}" ]
	then
		if uci commit dhcp
		then
			print_msg "Note: the adblock-lean developers are not aware of any other software that requires the specific addnmount entry created by adblock-lean." \
				"Should the addnmount entry be required for any reason then you will need to manually re-add it."
		else
			uci revert dhcp
			addnm_del_fail=1
		fi
	fi

	[ -n "${addnm_del_fail}" ] && log_msg -warn "Some addnmount entries were not deleted. Please delete manually."

	print_msg -purple "" "Deleting the scripts."
	rm -f "${ABL_SERVICE_PATH}"
	rm -rf "${ABL_LIB_DIR}"

	print_msg -purple "" "Uninstall complete."
	exit 0
}

enable()
{
	if rc_enabled
	then
		reg_msg -3 -green "The adblock-lean service is already enabled."
		return 0
	fi
	log_msg -purple "" "Enabling the adblock-lean service."
	rc_enable && rc_enabled ||
		{ reg_failure "Failed to enable the adblock-lean service"; return 4; }
	source_libs && load_config || return 3
	[ -n "${cron_schedule}" ] && { upd_cron_job || return 6; }
	:
}

disable()
{
	local rv=0
	if rc_enabled
	then
		log_msg -purple "Disabling adblock-lean."
		rm_cron_job
		rc_disable && ! rc_enabled ||
			{ reg_failure "Failed to disable the adblock-lean service"; local rv=1; }
		stop -noexit
	else
		reg_msg -3 "The adblock-lean service is already disabled."
	fi
	return "$rv"
}

calculate_limits()
{
	source_libs || exit 1
	CL_PRINT=1 CL_INTERACTIVE=1 do_calculate_limits "${@}"
	exit ${?}
}

set_ansi

# $luci_skip_dialogs is set if sourced from external RPC script for luci
[ -n "${luci_skip_dialogs}" ] && export ABL_LUCI_SOURCED=1

# detect when sourced from update() in older versions
check_func failsafe_log && UPD_SOURCED=1

# test process substitution support
