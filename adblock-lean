# Additional args: blocklist IDs (defaults to all)
do_stop()
{
	local file dir bl_ids all_stop_indexes='' dnsmasq_indexes bl_id_pr conf_dir \
		bl_params_failed='' \
		ASSERT_NOEXIT=1 FAIL_STOP_REQ='' \
		IFS="${DEFAULT_IFS}"

	init_command stop || exit 1
	load_config

	bl_ids="${*:-"${BL_IDS}"}"
	[ "${bl_ids}" = all ] && bl_ids="${BL_IDS}"

	if [ -z "${BL_IDS}" ] || ! set_global_env "${bl_ids}"
	then
		bl_ids="${BL_IDS}"
		GDI_NOFORCE=1 get_dnsmasq_instances
	fi

	if [ -n "${bl_ids}" ] &&
		bl_id_pr="blocklists: ${bl_ids}" &&
		for bl_id in ${bl_ids}
		do
			get_bl_params "${bl_id}" dnsmasq_indexes &&
			add2list all_stop_indexes "${dnsmasq_indexes}" ||
				{ bl_params_failed=1; break; }
		done &&
		[ -z "${bl_params_failed}" ] &&
		reg_action -1 -purple "" "Stopping adblocking for ${bl_id_pr}" &&
		rm_conf_scripts "${bl_ids}" &&
		rm_blocklists "${bl_ids}" &&
		restart_dnsmasq "${all_stop_indexes}" &&
		for bl_id in ${bl_ids}
		do
			CA_NOERR=1 get_bl_run_state "${bl_id}"
			[ ${?} = 4 ] || { bl_params_failed=1; break; }
		done &&
		[ -z "${bl_params_failed}" ] &&
		unset_metadata "${bl_ids}" &&
		set_bl_params "${bl_ids}" run_state=4 &&
		commit_metadata "${bl_ids}"
	then
		log_msg -purple "" "Successfully stopped adblocking for ${bl_id_pr}"
		return 0
	fi

	reg_action -1 -purple "" "Stopping adblocking for any adblock-lean blocklists."

	rm -f "${META_FILE}" "${ABL_RUN_DIR:?}/${BLOCKLIST_BASE_FNAME:-???}"*

	[ -n "${BL_IDS}" ] && 
	{
		rm_conf_scripts &&
		rm_bk
	}

	IFS="${_NL_}"
	for dir in ${ALL_CONF_DIRS}${_NL_}/tmp/dnsmasq.d${_NL_}/tmp/dnsmasq.cfg*.d
	do
		[ -n "${dir}" ] || continue
		IFS="${DEFAULT_IFS}"
		rm -f "${dir}/abl-conf-script" "${dir}/${BLOCKLIST_BASE_FNAME:-???}"*
	done
	IFS="${DEFAULT_IFS}"

	restart_dnsmasq # all dnsmasq instances

	return 1
}

restart()
{
	init_command restart || exit 1
	KEEP_PERSIST=0 do_stop "${@}" || exit 1
	start "${@}"
}

reload() { restart "${@}"; }

# return codes:
# 0 - adblock-lean blocklist is loaded
# 1 - error
# 2 - adblock-lean is performing an action
# 3 - adblock-lean is paused
# 4 - adblock-lean is stopped
status()
{
	check_lock
	case ${?} in
		1) exit 1 ;;
		2)
			report_curr_action
			exit 2
	esac

	init_command status || exit 1

	set_global_env || exit 1

	rc_enabled
	case ${?} in
		0) print_msg -green "" "adblock-lean service is enabled." ;;
		1) print_msg -yellow "" "adblock-lean service is disabled."
	esac

	local timestamp status_cnt='' status_cnt_human


	# TODO: get status_cnt

	case ${RUN_STATE_GLOBAL} in
		0) ;;
		1) reg_failure "adblock-lean is not working correctly. Consider running 'service adblock-lean restart' in order to restore adblocking." ;;
		3) print_msg -yellow "" "adblock-lean is paused." ;;
		4) print_msg -yellow "" "adblock-lean is stopped." ;;
	esac

	if [ "${RUN_STATE_GLOBAL}" = 0 ]
	then
		luci_good_line_count=${status_cnt}
		if [ "${status_cnt}" = 0 ]
		then
			log_msg -warn "No entries found in the blocklist file."
			RUN_STATE_GLOBAL=1
		else
			int2human status_cnt_human "${status_cnt}" || return 1
			timestamp="$(get_blocklist_timestamp -h)"
			print_msg "" \
				"${green}adblock-lean is active.${n_c}" \
				"Installed blocklist file: ${blue}${BL_FILE_CURR}${n_c}" \
				"Entries count: ${blue}${status_cnt_human}${n_c}" \
				"Blocklist was updated on: ${blue}${timestamp:-"${red}Unknown"}${n_c}"
			gen_stats -noexit
		fi
	fi

	[ -n "${PERSIST_BLOCKLIST_DIR}" ] && [ "${PERSIST_BLOCKLIST_MODE}" = managed ] && [ -n "${BL_FILE_CURR}" ] && [ "${BL_FILE_CURR%/*}" != "${PERSIST_BLOCKLIST_DIR}" ] &&
		print_msg -warn "" "Persistent blocklist directory is configured but not currently used."

	luci_dnsmasq_status=${RUN_STATE_GLOBAL}

	check_for_updates
	luci_update_status=${?}

	exit "${RUN_STATE_GLOBAL}"
}

# 1: pause|resume
# additional args: blocklist IDs
pause_resume()
{
	local cmd="${1:?}"
	shift
	init_command "${cmd}" &&
	set_global_env "${@}" || exit 1

	local \
		bl_ids="${*:-"${BL_IDS?}"}" \
		bl_id bl_id_pr \
		run_state \
		new_state \
		curr_path \
		curr_cnt \
		install_path \
		install_cnt \
		new_single_instance \
		pause_path \
		state_ok_pr \
		state_ok_msg \
		state_changed_pr \
		state_progr_pr \
		dnsmasq_indexes_to_restart='' \
		dnsmasq_indexes='' \
		action_taken_bl_ids='' \
		final_compr_to_file \
		failed_blocklists="${BL_IDS}" \
		ok_blocklists='' \
		FAIL_STOP_REQ=1 \
		cmd_rv=1

	case "${cmd}" in
		pause)
			new_state=3
			state_ok_pr="already paused" 
			state_changed_pr=paused
			state_progr_pr=Pausing ;;
		resume)
			new_state=0
			state_ok_pr="not paused" 
			state_changed_pr=resumed
			state_progr_pr=Resuming
	esac

	for bl_id in ${bl_ids}
	do
		get_bl_params -f "${cmd}" "${bl_id}" \
			final_compr_to_file \
			dnsmasq_indexes \
			run_state \
			curr_path \
			curr_cnt \
			pause_path \
			install_path \
			new_single_instance

		bl_id_pr="blocklist '${bl_id}'"

		case "${run_state}" in
			0|3|4) ;;
			*)
				reg_failure "Run state of ${bl_id_pr} is '${run_state}'."
				do_stop "${bl_id}"
				continue
		esac

		case "${cmd},${run_state}" in
			"pause,3"|"resume,0") state_ok_msg="Adblocking is ${state_ok_pr} for ${bl_id_pr}."  ;;
			"pause,4"|"resume,4") state_ok_msg="Adblocking is stopped for ${bl_id_pr}. Can not ${cmd}." ;;
			*) false
		esac &&
		{
			reg_msg "${state_ok_msg}"
			subtract_a_from_b "${bl_id}" "${failed_blocklists}" failed_blocklists
			continue
		}

		reg_action -blue "${state_progr_pr} ${bl_id_pr}."

		case "${cmd}" in
			pause)
				rm_conf_scripts "${bl_id}" &&
				mv_blocklist "${curr_path}" "${pause_path}" "${final_compr_to_file}" "${bl_id}" &&
				add2list dnsmasq_indexes_to_restart "${dnsmasq_indexes}" ;;
			resume)
				mv_blocklist "${curr_path}" "${install_path}" "${final_compr_to_file}" "${bl_id}" &&
				set_bl_params "${bl_id}" "install_cnt=${curr_cnt}" ;;
		esac &&
		set_bl_params "${bl_id}" \
			curr_single_instance="${new_single_instance}" ||
		{
			reg_failure "Failed to ${cmd} blocklist '${bl_id}'."
			do_stop "${bl_id}"
			continue
		}

		add2list action_taken_bl_ids "${bl_id}"
	done

	[ -n "${action_taken_bl_ids}" ] &&
	{
		case "${cmd}" in
			pause)
				restart_dnsmasq "${dnsmasq_indexes_to_restart}" &&
				ok_blocklists="${action_taken_bl_ids}" ;;
			resume)
				install_blocklists ok_blocklists _ "${action_taken_bl_ids}"
		esac
		cmd_rv=${?}
		[ ${cmd_rv} = 0 ] ||
			failed_blocklists="${action_taken_bl_ids}" ok_blocklists=''

		[ -n "${ok_blocklists}" ] &&
		{
			set_bl_params "${ok_blocklists}" run_state=${new_state}
			log_msg -purple "" "Adblocking is now ${state_changed_pr} for blocklists: ${blue}${ok_blocklists}${n_c}"
		}

		subtract_a_from_b "${ok_blocklists}" "${failed_blocklists}" failed_blocklists
		[ -n "${failed_blocklists}" ] && reg_failure -purple "Failed to ${cmd} blocklists '${failed_blocklists}'."
	}

	if [ -n "${failed_blocklists}" ]
	then
		do_stop "${failed_blocklists}"
	else
		cmd_rv=0
	fi

	commit_metadata "${bl_ids}"

	return ${cmd_rv}
}

# 1 (optional): blocklist IDs - defaults to all IDs
pause() { pause_resume pause "${@}"; exit ${?}; }

# 1 (optional): blocklist IDs - defaults to all IDs
resume() { pause_resume resume "${@}"; exit ${?}; }

# optional: '-s <path>' to simulate update (intended for testing: service adblock-lean update -s <path_to_new_ver> -v <version>)
# optional: -v [release|snapshot|<version>|branch=<github_branch>|commit=<commit_hash>]
# optional: '-f' to skip calling do_stop()
update()
{
	downg_not_supported() { reg_failure "Downgrade to versions earlier than v0.7.3 is not supported."; return 1; }

	# unset vars and functions from current version to have a clean slate with the new version
	clean_abl_env()
	{
		unset action ABL_CMD ABL_LIB_FILES ABL_EXTRA_FILES ABL_EXEC_FILES LIBS_SOURCED CONFIG_FORMAT CONFIG_LOADED ABL_ENV_SET MAIN_UTILS_DETECTED
		unset -f abl_post_update_1 abl_post_update_2 load_config update source_libs check_libs install_abl_files cleanup_and_exit
	}

	upd_failed()
	{
		local fail_msg="${1}"
		[ -s "${UCL_ERR_FILE}" ] && fail_msg="${fail_msg} uclient-fetch errors: '$(cat "${UCL_ERR_FILE}")'"
		[ -n "${fail_msg}" ] && reg_failure "${fail_msg}"
		reg_failure "Failed to update adblock-lean."
		rm -rf "${ABL_UPD_DIR:-???}" "${ABL_PID_DIR:-???}" "${UCL_ERR_FILE:-???}"
	}

	unexp_arg()
	{
		upd_failed "update: unexpected argument '${1}'."
	}

	local file req_ver='' ver_str_arg='' ver_type='' dist_dir='' upd_ver='' tarball_url='' \
		upd_channel='' req_upd_channel='' force_upd_channel='' upd_nostop=''

	IGNORE_CACHE=
	while getopts ":s:v:U:W:yfi" opt
	do
		case ${opt} in
			s) export sim_path="$OPTARG" ;;
			v) ver_str_arg=$OPTARG ;;
			U) force_upd_channel=$OPTARG ;;
			W) req_ver=$OPTARG ;;
			f) upd_nostop=1 libs_req='' ;;
			y) export APPROVE_UPD_CHANGES=1 DO_DIALOGS=0 ;;
			i) IGNORE_CACHE=1 ;; # global var
			*) unexp_arg "$OPTARG"; return 1
		esac
	done
	shift $((OPTIND-1))
	[ -z "${*}" ] || { unexp_arg "${*}"; return 1; }

	init_command update || { upd_failed; return 1; }

	[ -z "${upd_nostop}" ] && do_stop

	# parse version string from arguments into $req_upd_channel, $req_ver
	case "${ver_str_arg}" in
		'') ;;
		release|latest)
			req_upd_channel=release req_ver='' ;;
		snapshot)
			req_upd_channel="${ver_str_arg}" req_ver='' ;;
		commit=*)
			req_upd_channel="${ver_str_arg}" req_ver="${ver_str_arg#*=}" ;;
		branch=*)
			req_upd_channel="${ver_str_arg}" req_ver='' ;;
		[0-9]*|v[0-9]*)
			req_upd_channel=release
			req_ver="${ver_str_arg#*=}"
			req_ver="${req_ver#v}"
			;;
		*)
			upd_failed "Invalid version string '${ver_str_arg}'."
			return 1
	esac

	rm -rf "${ABL_UPD_DIR:-???}"
	try_mkdir -p "${ABL_UPD_DIR}" || { upd_failed; return 1; }

	upd_channel="${req_upd_channel:-"${ABL_UPD_CHANNEL}"}"
	upd_channel="${force_upd_channel:-"${upd_channel}"}"
	upd_channel="${upd_channel:-"release"}"

	dist_dir="${ABL_UPD_DIR}/dist"
	try_mkdir -p "${dist_dir}" || { upd_failed; return 1; }

	if [ -n "${sim_path}" ]
	then
		print_msg -yellow "Updating in simulation mode."
		[ -d "${sim_path}" ] || { upd_failed "Update simulation directory '${sim_path}' does not exist."; return 1; }
		[ -n "${ver_str_arg}" ] || { upd_failed "Specify new version string."; return 1; }
		upd_ver="${ver_str_arg}"

		[ -d "${sim_path}" ] || { upd_failed "Simulation source directory doesn't exist."; return 1; }
		cp -rT "${sim_path}" "${dist_dir}"
		log_msg "" "Updating adblock-lean to version '${upd_ver}' (update channel: '${upd_channel}')."
	else
		get_gh_ref "${upd_channel}" "${req_ver}" upd_ver tarball_url ver_type || { upd_failed; return 1; }
		case "${upd_channel}" in
			commit=*)
				# set update channel to 'commit=<full_commit_hash>'
				upd_channel="${upd_channel%=*}=${upd_ver}"
		esac
		log_msg "" "Downloading adblock-lean, ${ver_type} '${upd_ver}' (update channel: '${upd_channel}')."
		fetch_abl_dist "${tarball_url}" "${dist_dir}" || { upd_failed; return 1; }
	fi

	get_abl_version "${dist_dir}/adblock-lean"
	case "${?}" in
		2) downg_not_supported ;; # no version string found
		3) downg_not_supported ;; # old version format
		4) downg_not_supported ;; # v0.7.2
		5)
			# v0.7.3 or higher - call install_abl_files() from fetched installer
			(
				clean_abl_env
				INST_SOURCED=1 . "${dist_dir}/abl-install.sh" ||
					{ reg_failure "Failed to source fetched install script."; exit 1; }
				install_abl_files "${dist_dir}" "${upd_ver}" "${upd_channel}"
			) ;;
		*) reg_failure "Failed to get version from fetched adblock-lean distribution."; false ;;
	esac || exit 1

	log_msg -green "" "adblock-lean has been updated to version '${upd_ver}'."

	if [ "${DO_DIALOGS}" = 1 ]
	then
		print_msg "" "Start adblock-lean now? (y|n)"
		pick_opt "y|n"
	else
		REPLY=y
	fi

	if [ "${REPLY}" = y ]
	then
		clean_abl_env
		export ABL_IN_INSTALL=1
		. "${ABL_SERVICE_PATH}" || return 1
		start
	else
		exit 0
	fi
}

uninstall()
{
	init_command uninstall || return 1
	KEEP_PERSIST=0 do_stop
	if rc_enabled
		then
		log_msg -purple "Disabling adblock-lean."
		rc_disable && ! rc_enabled ||
			{ reg_failure "Failed to disable adblock-lean. Disable manually and then run this command again."; exit 1; }
	fi

	rm_cron_job

	if [ "${DO_DIALOGS}" = 1 ]
	then
		print_msg "" "Delete the config directory ${ABL_CONFIG_DIR}? (y|n)"
		pick_opt "y|n"
	else
		REPLY="${luci_uninstall_rm_config:-n}"
	fi

	if [ "${REPLY}" = y ]
	then
		print_msg -purple "Deleting the config directory."
		rm -rf "${ABL_CONFIG_DIR:-???}"
	fi

	local i="-1" addnm_deleted='' addnm_del_fail=''
	while [ ${i} -lt 128 ]
	do
		i=$((i+1))
		uci -q get dhcp.@dnsmasq[${i}] >/dev/null || break
		del_addnmounts "${i}"
		case ${?} in
			0) addnm_deleted=1 ;;
			3) ;;
			1) addnm_del_fail=1 ;;
			2) addnm_deleted=1 addnm_del_fail=1
		esac
	done

	if [ -n "${addnm_deleted}" ]
	then
		if uci commit dhcp
		then
			print_msg "Note: the adblock-lean developers are not aware of any other software that requires the specific addnmount entry created by adblock-lean." \
				"Should the addnmount entry be required for any reason then you will need to manually re-add it."
		else
			uci revert dhcp
			addnm_del_fail=1
		fi
	fi

	[ -n "${addnm_del_fail}" ] && log_msg -warn "Some addnmount entries in /etc/config/dhcp were not deleted. Please delete manually."

	print_msg "Deleting the adblock-lean hotplug script."
	rm -f "${ABL_HOTPLUG_PATH_ENABLED}" "${ABL_HOTPLUG_PATH_DISABLED}"

	print_msg -purple "Deleting adblock-lean scripts."
	rm -f "${ABL_SERVICE_PATH}"
	rm -rf "${ABL_LIB_DIR:-???}" "${ABL_RUN_DIR:-???}" "${ABL_TMP_DIR:-???}"

	print_msg -purple "" "Uninstall complete."
	exit 0
}

enable()
{
	init_command enable || return 1
	if rc_enabled
	then
		reg_msg -green "The adblock-lean service is already enabled."
		return 0
	fi
	rc_enable && rc_enabled ||
		{ reg_failure "Failed to enable the adblock-lean service"; return 4; }
	source_libs && load_config || return 3
	[ -n "${cron_schedule}" ] && { upd_cron_job || return 6; }
	:
}

disable()
{
	init_command disable || return 1
	local rv=0
	if rc_enabled
	then
		rm_cron_job
		rc_disable && ! rc_enabled ||
			{ reg_failure "Failed to disable the adblock-lean service"; local rv=1; }
		do_stop
	else
		reg_msg "The adblock-lean service is already disabled."
	fi
	return "${rv}"
}

calculate_limits()
{
	init_command calculate_limits || return 1
	CL_PRINT=1 CL_INTERACTIVE=1 do_calculate_limits "${@}"
	exit ${?}
}


LIBS_SOURCED=
MAIN_UTILS_DETECTED=

set_ansi

# $luci_skip_dialogs is set if sourced from external RPC script for luci
[ -n "${luci_skip_dialogs}" ] && export ABL_LUCI_SOURCED=1

# detect when sourced from update() in older versions
check_func failsafe_log && UPD_SOURCED=1

export ABL_INIT_ACTION="${action}"

# register 1st arg as $SH_CMD when called by 'sh /etc/init.d/adblock-lean'
if [ "${0}" = "${ABL_SERVICE_PATH}" ] &&
	{
		is_included "${1}" "${ABL_BUILTIN_CMDS} ${ABL_CUSTOM_CMDS}" || { print_msg -err "Unexpected command '${1}'"; exit 1; }
	}
then
	SH_CMD="${1}"
	ABL_INIT_ACTION=${SH_CMD}
	shift
	${SH_CMD} "${@}"
	exit ${?}
fi


