# checks if string $1 is included in space-separated list $2
# if $3 is specified, uses the value as list delimiter
# result via return status
is_included() {
	local delim="${3:-" "}"
	case "${delim}${2}${delim}" in
		*"${delim}${1}${delim}"*)
			return 0 ;;
		*)
			return 1
	esac
}

# adds a string to a space-separated list if it's not included yet
# 1 - name of var which contains the list
# 2 - new value(s)
# 3 - (optional) list delimiter (instead of whitespace)
# returns 1 if bad var name, 0 otherwise
add2list() {
	case "${1:?}" in *[!A-Za-z0-9_]*)
		return 1
	esac

	local a2l_val curr_list delim="${3:-" "}"

	eval "curr_list=\"\${${1}}\""
	local IFS="${delim}"
	for a2l_val in ${2}
	do
		case "${a2l_val}" in '') continue; esac
		is_included "${a2l_val}" "${curr_list}" "${delim}" && continue
		curr_list="${curr_list}${curr_list:+"${delim}"}${a2l_val}"
	done
	export -n "${1}=${curr_list}"
	:
}

# subtract list $1 from list $2, with optional field separator $4 (otherwise uses whitespace)
# output via optional variable with name $3
# returns status 0 if the result is null, 1 if not
subtract_a_from_b() {
	local sab_out="${3:-___dummy}" IFS="${DEFAULT_IFS}"
	are_var_names_safe "${sab_out}" || return 1
	case "${2}" in '') export -n "${sab_out}="; return 0; esac
	case "${1}" in '') export -n "${sab_out}=${2}"; [ ! "${2}" ]; return; esac
	local _fs_su="${4:-" "}"
	local e rv_su=0 _subt=
	local IFS="${_fs_su}"
	for e in ${2}; do
		is_included "${e}" "${1}" "${_fs_su}" || { add2list _subt "${e}" "${_fs_su}"; rv_su=1; }
	done
	export -n "${sab_out}=${_subt}"
	return ${rv_su}
}

# reads first line from file into variables
# Args:
# -v <out_var_name>
# -f <file_path>
# Optional args:
# '-a <attempts_num>'
# '-d' to delete the file after reading
# '-q' to quiet error message
# '-n X' to limit number of bytes read
# '-D <"[file_desc]">'
# '-V <"[default_val]">'
# '-F <"[fs_char]">'
# '-E <"[eof_char]">'
read_str_from_file()
{
	local me=read_str_from_file rs_del_file='' rs_quiet='' rs_num_bytes='' rs_outvars='' rs_file='' \
		rs_file_desc='' rs_def_val='' rs_read_failed='' rs_attempts=1 rs_attempt rs_var rs_fs="${DEFAULT_IFS}" rs_eof="${_NL_}" \
		IFS="${DEFAULT_IFS}"
	while getopts ":dqn:v:f:a:D:V:F:E:" opt
	do
		case "${opt}" in
			d) rs_del_file=1 ;;
			q) rs_quiet=1 ;;
			n) rs_num_bytes=-n${OPTARG} ;;
			v) rs_outvars=${OPTARG} ;;
			f) rs_file=${OPTARG} ;;
			a) rs_attempts=${OPTARG} ;;
			D) rs_file_desc=${OPTARG} ;;
			V) rs_def_val=${OPTARG} ;;
			F) rs_fs="${OPTARG}" ;;
			E) rs_eof="${OPTARG}" ;;
			*) reg_failure "${me}: unexpected option '${opt}'."; return 1;
		esac
	done

	assert_set "F_${me}" rs_outvars rs_file &&
	unset_vars ${rs_outvars} || return 1

	rs_attempt=0
	while :
	do
		rs_attempt=$((rs_attempt+1))
		[ "${rs_attempt}" -le "${rs_attempts}" ] || { rs_read_failed=1; break; }
		[ "${rs_attempt}" = 1 ] || sleep 1

		IFS="${rs_fs}" read -r -d "${rs_eof}" ${rs_num_bytes?} ${rs_outvars?} 2>/dev/null < "${rs_file}"
		for rs_var in ${rs_outvars}
		do
			case "${rs_var}" in _) continue; esac
			eval "[ -n \"\${${rs_var}}\" ]" || continue 2
		done
		break
	done

	[ -n "${rs_del_file}" ] && rm -f "${rs_file}"
	[ -z "${rs_read_failed}" ] && return 0

	for rs_var in ${rs_outvars}
	do
		export -n "${rs_var}=${rs_def_val}"
	done

	[ -n "${rs_quiet}" ] || reg_failure "Failed to read${rs_file_desc:+ }${rs_file_desc} file '${rs_file}'."

	return 1
}

# 0 - (optional) '-p'
# 1 - path
try_mkdir()
{
	local p=
	[ "${1}" = '-p' ] && { p='-p'; shift; }
	[ -d "${1}" ] && return 0
	mkdir ${p} "${1}" || { reg_failure "Failed to create directory '${1}'."; return 1; }
	:
}

# asks the user to pick an option
# 1 - input in the format 'a|b|c'
# output via $REPLY
pick_opt()
{
	update_action_file "Waiting for user input in console" || return 1
	while :
	do
		printf %s "${lblue}${1//"|"/"${n_c}|${lblue}"}${n_c}: " > "${MSGS_DEST}"
		read -r REPLY
		case "${REPLY}" in *[!A-Za-z0-9_]*) printf '\n%s\n\n' "Please enter ${1}" > "${MSGS_DEST}"; continue; esac
		eval "case \"${REPLY}\" in
				${1}) return 0 ;;
				*) printf '\n%s\n\n' \"Please enter ${1}\" > \"${MSGS_DEST}\"
			esac"
	done
}

