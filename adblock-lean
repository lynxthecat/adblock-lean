# Looks for blockset-*.conf files and populates ${SET_IDS}
# 1 (optional): var name to output found paths (newline-separated)
find_set_configs()
{
	# shellcheck disable=SC2329
	append_set_id()
	{
		local cfg_id
		split_path _ cfg_id _  "${1}"
		cfg_id="${cfg_id#"blockset-"}"
		is_alphanum "${cfg_id}" ||
		{
			reg_failure "Invalid blockset name '${cfg_id}' in file '${1}'. Only English letters, numbers and underlines are allowed. Ignoring the file."
			return 0
		}
		add2list SET_IDS "${cfg_id}"

		[ -n "${2}" ] && add2list "${2}" "${1}" "${_NL_}"
		:
	}

	unset_vars "${1:-_}" || return 1

	SET_IDS=

	FF_EXEC="append_set_id {} ${1}" \
		find_files _ "${ABL_CFG_DIR:?}" "blockset-" "*" ".conf"

	case ${?} in
		0|2) ;;
		*) return 1
	esac

	:
}

# Splits path to file into dir, filename, ext
split_path()
{
	local sp_file='' sp_fname='' sp_ext='' sp_dir='' \
		sp_dir_out_var="${1}" sp_fname_out_var="${2}" sp_ext_out_var="${3}" sp_path="${4}"

	unset_vars "${sp_dir_out_var}" "${sp_fname_out_var}" "${sp_ext_out_var}" || return 1

	case "${sp_path}" in
		# ignore files directly in /
		/[!/]*)
			sp_file="${sp_path##*"/"}"
			sp_fname="${sp_file%.*}"
			case "${sp_file}" in
				*.*) sp_ext="${sp_file##*.}" ;;
			esac
	esac

	[ -n "${sp_fname}" ] || return 1

	sp_dir="${sp_path%"${sp_file}"}"
	sp_dir="${sp_dir%"/"}"

	[ -n "${sp_dir}" ] && [ -n "${sp_fname}" ] &&
	export -n "${sp_dir_out_var}=${sp_dir}" "${sp_fname_out_var}=${sp_fname}" "${sp_ext_out_var}=${sp_ext}"
}

is_valid_dir()
{
	local fail_cmd="reg_failure"
	[ "${1}" = '-q' ] && { fail_cmd="debug_msg"; shift; }
	case "${1}" in
		''|"/"|[!/]*) ${fail_cmd} "Unexpected or invalid dir '${1}'."; return 1
	esac
	:
}

# Env vars: FORCE_PERSIST_WRITE
is_dir_writable()
{
	local persist_dir persist_mode
	is_valid_dir -q "${2}" &&
	get_params "${1}" persist_dir persist_mode || return 1

	[ -n "${FORCE_PERSIST_WRITE}" ] ||
	{ [ -n "${persist_dir}" ] && [ "${2}" != "${persist_dir}" ]; } ||
	{ [ "${persist_mode}" = managed ] && [ "${KEEP_PERSIST}" != 1 ]; } ||
	{
		[ -z "${persist_dir}" ] &&
		case "${2}" in
			/tmp|/tmp/*|"${ABL_RUN_DIR:?}"*) : ;;
			*) false
		esac
	}
}

rm_if_writable()
{
	local dir filename path removed='' \
		set_id="${1:?}"
	shift
	for path in "${@}"
	do
		split_path dir filename _ "${path}" &&
		[ -n "${dir}" ] && [ -n "${filename}" ] &&
		is_dir_writable "${set_id}" "${dir}" || continue

		rm -f "${dir}/${filename}" "${dir}/${filename}."*
		removed=1
	done
	[ -n "${removed}" ]
}

rm_bk()
{
	local set_id bk_file set_ids="${*:-"${SET_IDS}"}"
	for set_id in ${set_ids}
	do
		get_params "${set_id}" bk_file &&
		[ -n "${bk_file}" ] &&
		rm_if_writable "${set_id}" "${bk_file}" &&
		set_params "${set_id}" "bk_file="
	done
}

# Env vars:
# KEEP_PERSIST, KEEP_BK
rm_blocksets()
{
	local set_id install_path curr_path curr_persist_path rm_enum rm_path \
		rm_rv=0 \
		set_ids="${*:-"${SET_IDS}"}"

	for set_id in ${set_ids}
	do
		get_params "${set_id}" install_path curr_path curr_persist_path bk_file || { rm_rv=1; continue; }
		[ -n "${KEEP_PERSIST}" ] && curr_persist_path=
		[ -n "${KEEP_BK}" ] &&
		{
			[ "${curr_path}" = "${bk_file}" ] && curr_path=
			[ "${curr_persist_path}" = "${bk_file}" ] && curr_persist_path=
		}
		[ -n "${install_path}${curr_path}${curr_persist_path}" ] || continue
		[ -n "${curr_path}${curr_persist_path}" ] && reg_msg -fb "${set_id}" "Removing any existing blockset files{}."
		for rm_enum in curr install curr_persist
		do
			eval "rm_path=\"\${${rm_enum}_path}\""
			[ -n "${rm_path}" ] || continue
			[ "${rm_enum}" = install ] || set_params "${set_id}" "${rm_enum}_path"=
			rm_if_writable "${set_id}" "${rm_path}" "${rm_path%/*}/${META_FNAME_PERSIST:?}"
		done
	done

	return ${rm_rv}
}

rm_conf_scripts()
{
	local rv=0 set_id conf_dir conf_dirs \
		set_ids="${*:-"${SET_IDS}"}"

	for set_id in ${set_ids}
	do
		debug_msg "${set_id}: removing conf-scripts"
		get_params "${set_id}" conf_dirs || { rv=1; continue; }
		for conf_dir in ${conf_dirs}
		do
			rm -f "${conf_dir}/${CS_BASE_FNAME}-${set_id}"
		done
	done

	return ${rv}
}

rc_disable()
{
	rm -f /etc/rc.d/S${START}adblock-lean /etc/rc.d/K${STOP}adblock-lean
}

rc_enable()
{
	local err=1
		ln -sf "../init.d/adblock-lean" "/etc/rc.d/S${START}adblock-lean" && err=0
		ln -sf "../init.d/adblock-lean" "/etc/rc.d/K${STOP}adblock-lean" && err=0
	return $err
}

rc_enabled()
{
	[ -L "/etc/rc.d/S${START}adblock-lean" ] &&
	[ -L "/etc/rc.d/K${STOP}adblock-lean" ]
}

# Detect package manager (opkg or apk)
# Sets global vars: $PKG_MANAGER $PKG_INSTALL_CMD $PKG_FILES_LIST_CMD
detect_pkg_manager() {
	local apk_present='' opkg_present=''
	check_util apk && apk_present=1
	check_util opkg && opkg_present=1
	if [ -n "$apk_present" ] && [ -n "$opkg_present" ]
	then
		reg_failure "Both apk and opkg package managers present in the system."
		return 1
	fi

	if [ -n "$apk_present" ]
	then
		export -n \
			PKG_MANAGER=apk \
			PKG_INSTALL_CMD="apk add" \
			PKG_FILE_LIST_CMD="apk info --contents"
	elif [ -n "$opkg_present" ]
	then
		export -n \
			PKG_MANAGER=opkg \
			PKG_INSTALL_CMD="opkg install" \
			PKG_FILE_LIST_CMD="opkg files"
	else
		reg_failure "Failed to detect package manager."
		return 1
	fi
	:
}

report_utils()
{
	local util pkg_name awk_inst_tip='' sed_inst_tip='' sort_inst_tip=''

	for util in ${RECOMMENDED_UTILS}
	do
		case "${PKG_MANAGER}" in
			opkg|apk)
				get_pkg_name pkg_name "${util}" || return 1
				export -n "${util}_inst_tip= (${PKG_INSTALL_CMD} ${pkg_name})" ;;
			*)
				unset "${util}_inst_tip" ;;
		esac
	done

	case "${AWK_CMD}" in
		*gawk*) ;;
		*)
			reg_msg -yellow "" "gawk not detected so allowlist (sub)domains removal from blockset will be slow and list processing will not be as efficient."
			reg_msg "Consider installing the gawk package${awk_inst_tip} for faster processing and (sub)domain match removal."
	esac

	case "${SED_CMD}" in
		*gnu*) ;;
		*)
			reg_msg -yellow "" "GNU sed not detected so list processing will be a little slower."
			reg_msg "Consider installing the GNU sed package${sed_inst_tip} for faster processing." ;;
	esac

	case "${SORT_CMD}" in
		*coreutils*) ;;
		*)
			reg_msg -yellow "" "coreutils-sort not detected so sort will be a little slower."
			reg_msg "Consider installing the coreutils-sort package${sort_inst_tip} for faster sort." ;;
	esac
}

detect_util()
{
	try_detect_util()
	{
		local res_name=''

		# try specific path
		[ -n "${specific_path}" ] && [ -f "${specific_path}" ] && _util_path="${specific_path}" && return 0

		# try to resolve specific name, then gen game
		{
			{ [ -n "${specific_name}" ] && check_util "${specific_name}" && res_name="${specific_name}"; } ||
			{ [ -n "${gen_name}" ] && check_util "${gen_name}" && res_name="${gen_name}"; }
		} &&
		_util_path="$(command -v "${res_name}")" &&
		[ -n "${_util_path}" ] &&
		return 0

		# fall back to checking files in Busybox package
		[ -n "${gen_name}" ] &&
		{ [ -n "${PKG_MANAGER}" ] || detect_pkg_manager; } &&
		{ [ -n "${BB_FILES}" ] || BB_FILES="$(${PKG_FILE_LIST_CMD} busybox)"; } &&
		case "${BB_FILES}" in
			*/"${gen_name}" ) _util_path="$( printf '%s\n' "${BB_FILES}" | grep ".*/${gen_name}$" )" && [ -f "${_util_path}" ] ;;
			*) false
		esac && return 0
		return 1
	}

	local me=detect_util _util_path \
		du_out_var="${1}" gen_name="${2}" specific_name="${3}" specific_path="${4}"

	[ ${#} -ge 4 ] || { bad_args "${me}" "${@}"; return 1; }

	unset_vars "${du_out_var}" || return 1

	try_detect_util &&
	{
		debug_msg "${du_out_var}=${_util_path}"
		export -n "${du_out_var}=${_util_path}"
		return 0
	}

	reg_failure "${me}: '${gen_name:-"${specific_name}"}' not found."
	return 1
}

# 1 (optional) : '-f' to force re-detection
# sets vars for main utils
# shellcheck disable=SC2120
detect_main_utils()
{
	[ -n "${MAIN_UTILS_DETECTED}" ] && [ "${1}" != '-f' ] && return 0

	local IFS="${DEFAULT_IFS}" util_params failed_utils=''
# Format:	VAR			gen_name	specific_name	specific_path
	for util_params in \
		"AWK_CMD		awk			gawk	/usr/bin/gawk				" \
		"SED_CMD		sed			''		/usr/libexec/sed-gnu		" \
		"SORT_CMD		sort		''		/usr/libexec/sort-coreutils	" \
		"CAT_CMD		cat			''		/bin/cat					" \
		"LOG_CMD		logger		''		/usr/bin/logger				" \
		"DF_CMD			df			''		/bin/df						" \
		"MD5_CMD		md5sum		''		/usr/bin/md5sum				" \
		"NSLOOKUP_CMD	nslookup	''		/usr/bin/nslookup			" \
		"PIDOF_CMD		pidof		''		/bin/pidof					" \
		"PGREP_CMD		pgrep		''		/usr/bin/pgrep				" \
		"NETSTAT_CMD	netstat		''		/bin/netstat				" \
		"IP_CMD			ip			''		/sbin/ip					"
	do
		eval "set -- ${util_params}" && # eval needed because some fields are ''
		unset_vars "${1}" &&
		detect_util "${1}" "${2}" "${3}" "${4}" ||
			add2list failed_utils "${2}" ', '
	done

	[ -z "${failed_utils}" ] || { reg_failure "Can not find essential utilities: ${failed_utils}.";  return 1; }
	MAIN_UTILS_DETECTED=1
	:
}

reg_failure()
{
	local arg fail_msg
	log_msg -err "${@}"
	for arg in "${@}"; do
		fail_msg="${fail_msg:+"${fail_msg}${_NL_}"}${arg}"
	done
	luci_errors="${fail_msg}"
}

reg_success() { log_msg -report "${@}"; }

reg_action() { reg_msg -action "${@}"; }

print_msg() { reg_msg -4 "${@}"; }

log_msg() { reg_msg -1 "${@}"; }

debug_msg()
{
	local prefix="${orange}debug:${n_c}"
	case ${#} in
		1) reg_msg -5 "${prefix} ${1}" ;;
		*) reg_msg -5 "" "${prefix}" "${@}" ""
	esac
}

# Depending on msg-specific log level, on global ${LOG_VERBOSITY} and on ${ABL_DEBUG}:
# Prints each msg separately to console [ and to log file ] [ and sends to system log ] [ and registers action ]

# Log/print thresholds:
# console:     [ msg_level <= 4 ]  ( or if ${ABL_DEBUG} is set: [ msg_level <= 5 ] )
# session log: [ msg_level <= 3 ]
# syslog:      [ msg_level <= 1 ]  (configurable via ${LOG_VERBOSITY} option)

# Optional args:
# -[0|1|2|3|4|5] : message level (default: 3)
# -[action|report|noprint|err|warn|[color]
# -b: append 'blockset[s] <OPTARG>' to the message
# -fb|-wb: same as above, plus [for ]|[with ] prefix
reg_msg()
{
	append_msg()
	{
		msgs="${msgs}${msgs_prefix}${1}${_DELIM_}"
		[ -n "${msgs_prefix}" ] && msgs_prefix=
	}

	dbg_off

	local m msgs='' msgs_nc='' msgs_prefix='' _arg err_l=info color='' _n_c='' \
		print_req='' sys_log_req='' log_file_req='' action_req='' report_req='' noprint='' \
		set_ids='' ids_pr_prefix='' fetch_ids='' set_ids_pr='' \
		msg_level='' msgs_dest="${MSGS_DEST}" \
		\
		reg_req='' \
		sys_log_thresh="${LOG_VERBOSITY:-"1"}"

	local IFS="${DEFAULT_IFS}"
	for _arg in "${@}"
	do
		[ -n "${fetch_ids}" ] &&
		{
			fetch_ids=
			set_ids=${_arg}
			continue
		}
		case "${_arg}" in
			-[0-9])
				if [ -z "${msg_level}" ]
				then
					msg_level="${_arg#"-"}"
					for thresh in "${PRINT_THRESH:?}" "${sys_log_thresh}" "${SESSION_LOG_THRESH:?}"
					do
						[ "${msg_level}" -le "${thresh}" ] && { reg_req=1; break; }
					done
					[ -n "${reg_req}" ] || { dbg_on; return 0; } # short path for debug messages when ABL_DEBUG is not set
				else
					append_msg "${_arg}"
				fi ;;
			-b) fetch_ids=1 ;;
			-fb) ids_pr_prefix="for " fetch_ids=1 ;;
			-wb) ids_pr_prefix="with " fetch_ids=1 ;;
			-noprint) noprint=1 ;;
			-report) report_req=1 ;;
			-action) [ -n "${LOCK_REQ}" ] && action_req=1 ;;
			-err) err_l=err color="${red}" msgs_prefix="Error: " ;;
			-warn) err_l=warn color="${yellow}" msgs_prefix="Warning: " ;;
			-blue|-lblue|-red|-green|-purple|-yellow|-orange) eval "color=\"\$${_arg#"-"}\"" ;;
			'') msgs="${msgs}dummy${_DELIM_}" ;;
			*) append_msg "${_arg}"
		esac
	done
	msgs="${msgs%"${_DELIM_}"}"

	[ -n "${set_ids}" ] && { [ -z "${SET_IDS}" ] || ! subtract_a_from_b "${set_ids}" "${SET_IDS}"; } &&
	{
		case "${set_ids}" in
			*" "*) set_ids_pr=" ${ids_pr_prefix}blocksets: ${lblue}${set_ids// /"${n_c}, ${lblue}"}${n_c}" ;;
			*) set_ids_pr=" ${ids_pr_prefix}blockset ${lblue}${set_ids}${n_c}" ;;
		esac
	}
	msgs="${msgs//"{}"/"${set_ids_pr}"}"

	: "${msg_level:=3}"

	[ "${msg_level}" = 5 ] && msgs_dest="/dev/stderr" # Debug

	[ -z "${noprint}" ] && [ "${msg_level}" -le "${PRINT_THRESH}" ] && [ "${msgs_dest}" != "/dev/null" ] && print_req=1
	[ "${msg_level}" -le "${sys_log_thresh}" ] && sys_log_req=1
	[ "${msg_level}" -le "${SESSION_LOG_THRESH}" ] && log_file_req=1

	set -f

	if [ -n "${print_req}" ]
	then
		[ -n "${color}" ] ||
		case "${msgs}" in
			*"${n_c}"*) : ;;
			*) false
		esac && _n_c="${n_c}"

		IFS="${_DELIM_}"
		for m in ${msgs//"${n_c}"/"${color:-"${n_c}"}"}
		do
			IFS="${DEFAULT_IFS}"
			case "${m}" in
				dummy) printf '\n' > "${msgs_dest}" ;;
				*) printf '%s\n' "${color}${m}${_n_c}" > "${msgs_dest}"
			esac
		done
		IFS="${DEFAULT_IFS}"
	fi

	if [ -n "${sys_log_req}" ] || [ -n "${log_file_req}" ] || [ -n "${report_req}" ] || [ -n "${action_req}" ]
	then
		msgs_nc="${msgs}"
		for c in "${red}" "${green}" "${blue}" "${lblue}" "${purple}" "${yellow}" "${orange}"
		do
			msgs_nc="${msgs_nc//"${c}"/}"
		done

		IFS="${_DELIM_}"
		for m in ${msgs_nc//"${n_c}"/}
		do
			IFS="${DEFAULT_IFS}"
			case "${m}" in
				dummy|'') ;;
				*)
					[ -n "${sys_log_req}" ] && ${LOG_CMD:-logger} -t adblock-lean -p user."${err_l}" "${m}"
					[ -n "${log_file_req}" ] && [ -n "${ABL_CURR_LOG_FILE}" ] && date +"[%b %d %Y, %H:%M:%S] ${err_l:-info}: ${m}" >> "${ABL_CURR_LOG_FILE}" &
			esac
		done
		IFS="${DEFAULT_IFS}"
		[ -n "${report_req}" ] && [ -n "${custom_scr_sourced}" ] && check_func report_success && report_success "${msgs_nc//"${_DELIM_}"/"${_NL_}"}"
		[ -n "${action_req}" ] && { update_action_file "${msgs_nc//"${_DELIM_}"/" "}" || { set +f; return 1; }; }
	fi

	set +f
	dbg_on
}

graceful_exit()
{
	[ -n "${ABL_LUCI_SOURCED}" ] && [ -z "${UPD_SOURCED}" ] && abl_luci_exit "${1:-0}"
	exit "${1:-0}"
}

trap_and_catch() {
	local sig trap_call="${1}"
	shift
	for sig in "${@}"; do
		# shellcheck disable=SC2064
		trap "log_msg -yellow \"\" \"Exiting on receipt of ${sig} signal.\"; ${trap_call}" "${sig}"
	done
}

# exit with code ${1}
# if function 'abl_luci_exit' is defined, execute it before exit
cleanup_and_exit()
{
	trap - INT TERM EXIT
	if [ -n "${CLEANUP_REQ}" ]
	then
		[ "${1}" != 0 ] && print_msg "" "Cleaning up..."
		[ -n "${SCHEDULER_PID}" ] && {
			kill -s USR1 "${SCHEDULER_PID}" 2>/dev/null
			wait_on_pid "${SCHEDULER_PID}" 5
			[ -d "/proc/${SCHEDULER_PID}" ] && kill_pids_recursive "${SCHEDULER_PID}"
		}
	fi

	if [ -n "${METADATA_COMMIT_REQ}" ]
	then
		commit_metadata || exit 1
	fi

	rm -rf "${ABL_TMP_DIR}" "${ABL_CFG_STAGING_DIR}"

	if [ "${1}" != 0 ] && [ -n "${FAIL_STOP_REQ}" ]
	then
		ABL_NOTRAPS=1 do_stop
		rm -rf "${ABL_RUN_DIR}"
	fi

	[ -n "${LOCK_REQ}" ] && rm_lock
	local recent_log=
	[ -n "${ABL_CURR_LOG_FILE}" ] && [ -s "${ABL_CURR_LOG_FILE}" ] && read -rd '' recent_log < "${ABL_CURR_LOG_FILE}"
	luci_log="${recent_log}"

	# execute custom script actions
	if [ -z "${ABL_LUCI_SOURCED}" ] && [ -n "${failure_msg}" ] && [ -n "${custom_scr_sourced}" ] && check_func report_failure
	then
		[ -n "${recent_log}" ] && failure_msg="${failure_msg}${_NL_}${_NL_}Session log:${_NL_}${recent_log}"
		report_failure "${failure_msg}"
	fi
	if [ -n "${UPD_AVAIL_MSG}" ] && check_func report_update
	then
		report_update "${UPD_AVAIL_MSG}${_NL_}${UPD_DIRECTIONS}"
	fi

	[ -n "${ABL_LUCI_SOURCED}" ] && abl_luci_exit "${1}"

	printf '\n' > "${MSGS_DEST}"
	exit "${1}"
}

dnsmasq_stop_restart_shared()
{
	local rv index d_indexes dnsmasq_indexes cmd_pr inst_pr inst_name cmd_fail='' d_fail_ids='' \
		cmd="${1}" set_ids="${2}" d_ok_ids_out_var="${3:-_}" indexes_out_var="${4:-_}" inst_names_out_var="${5:-_}"

	unset_vars "${indexes_out_var}" "${inst_names_out_var}" "${d_ok_ids_out_var}" || return 1

	case "${cmd}" in
		stop) cmd_pr=Stopping ;;
		restart) cmd_pr=Restarting ;;
	esac

	if [ -n "${set_ids}" ] &&
		for set_id in ${set_ids}
		do
			ASSERT_NOEXIT=1 get_params -f "${cmd}" "${set_id}" dnsmasq_indexes || { cmd_fail=1; break; }
			add2list d_indexes "${dnsmasq_indexes}"
		done &&
		[ -z "${cmd_fail}" ] &&
		[ -n "${d_indexes}" ]
	then
		:
	else
		# fall back to all instances
		reg_action "" "${cmd_pr} all dnsmasq instances." || return 1
		[ -n "${set_ids}" ] && rv=1
		/etc/init.d/dnsmasq "${cmd}" &> /dev/null ||
		{
			reg_failure "Command '/etc/init.d/dnsmasq ${cmd}' returned code ${?}."
			[ -n "${SET_IDS}" ] && set_params "${SET_IDS}" run_state=1
			return 1
		}
		return 0
	fi

	for index in ${d_indexes}
	do
		if
			eval "inst_name=\"\${DNSMASQ_INST_NAME_${index}}\"" &&
			{
				[ -n "${inst_name}" ] || { reg_failure "Internal error: dnsmasq instance name unknown for index '${index}'."; false; }
			}
		then
			inst_pr="dnsmasq instance ${lblue}${inst_name}${n_c}"
		else
			inst_pr="all dnsmasq instances"
			inst_name=
		fi
		reg_action "" "${cmd_pr} ${inst_pr}." || return 1

		if /etc/init.d/dnsmasq "${cmd}" "${inst_name}" &> /dev/null
		then
			add2list "${inst_names_out_var}" "${inst_name}"
			add2list "${indexes_out_var}" "${index}"
		else
			reg_failure "Command '/etc/init.d/dnsmasq ${cmd} \"${inst_name}\"' returned code ${?}."
			rv=1
			if [ -n "${set_ids}" ] && [ -n "${inst_name}" ]
			then
				for set_id in ${set_ids}
				do
					get_params "${set_id}" dnsmasq_indexes
					is_included "${index}" "${dnsmasq_indexes}" || continue
					set_params "${set_id}" run_state=1
					add2list d_fail_ids "${set_id}"
				done
			else
				[ -n "${SET_IDS}" ] && set_params "${SET_IDS}" run_state=1
			fi
		fi
		[ -n "${inst_name}" ] || break
	done
	subtract_a_from_b "${d_fail_ids}" "${set_ids}" "${d_ok_ids_out_var}"
	return "${rv:-0}"
}

stop_dnsmasq()
{
	dnsmasq_stop_restart_shared stop "${*}"
}

# 1: new run state
# 2: var to output OK set ID's
# 3: indexes (defaults to all)
restart_dnsmasq()
{
	local rv index indexes inst_name inst_names \
		dnsmasq_indexes \
		p1_ok_ids \
		restart_ok_ids \
		restart_fail_ids='' \
		ns ns4 ns6 \
		inst_init_pr \
		res_attempts \
		new_run_state="${1}" restart_ok_ids_out_var="${2:-_}" set_ids="${3}"

	unset_vars "${restart_ok_ids_out_var}" || return 1
	dnsmasq_stop_restart_shared restart "${set_ids}" p1_ok_ids indexes inst_names || rv=1
	subtract_a_from_b "${p1_ok_ids}" "${set_ids}" restart_fail_ids

	if [ -n "${inst_names}" ] && [ -n "${indexes}" ]
	then
		inst_init_pr="initialization of dnsmasq instances: ${lblue}${inst_names// /"${n_c}, ${lblue}"}${n_c}"
	else
		indexes=all
		inst_init_pr="dnsmasq initialization"
	fi

	res_attempts=$(seq 1 60)

	# TODO: async
	reg_msg "Waiting for ${inst_init_pr}." || return 1
	for index in ${indexes}
	do
		eval \
			"inst_name=\"\${DNSMASQ_INST_NAME_${index}}\"" \
			"ns4=\"\${NS4_${index}}\"" \
			"ns6=\"\${NS6_${index}}\""

		ns="${ns4:="${ns6}"}"

		: "${ns:="127.0.0.1"}"

		debug_msg "Check cmd: ${NETSTAT_CMD} -plnt | ${SED_CMD} -E 's/^\s+//;s/[^ ]+\s+[^ ]+\s+[^ ]+\s+//' | grep -q \"^${ns}:.*/dnsmasq\s*$\""
		for i in ${res_attempts:-1 2 3 4 5}
		do
			${NETSTAT_CMD:?} -plnt 2>/dev/null | ${SED_CMD:?} -E 's/^\s+//;s/[^ ]+\s+[^ ]+\s+[^ ]+\s+//' | grep -q "^${ns}:.*/dnsmasq\s*$" &&
				continue 2
			sleep 1
		done

		rv=1
		if [ "${index}" != all ]
		then
			for set_id in ${set_ids}
			do
				get_params "${set_id}" dnsmasq_indexes || return 1
				is_included "${index}" "${dnsmasq_indexes}" || continue
				set_params "${set_id}" run_state=1
				add2list restart_fail_ids "${set_id}"
			done
		else
			[ -n "${SET_IDS}" ] && set_params "${SET_IDS}" run_state=1
		fi

		index_pr="${index}"
		[ "${index}" = all ] && index_pr=
		reg_failure "DNS self-test failed${index_pr:+" for dnsmasq instance ${index_pr}"}${inst_name:+" ('${inst_name}')"}."
	done

	subtract_a_from_b "${restart_fail_ids}" "${set_ids}" restart_ok_ids
	[ -n "${new_run_state}" ] && [ -n "${restart_ok_ids}" ] &&
		set_params "${restart_ok_ids}" run_state="${new_run_state}"
	export -n "${restart_ok_ids_out_var}=${restart_ok_ids}"
	return "${rv:-0}"
}

# return codes:
# 0 - success
# 1 - error
# 254 - lock file already exists
mk_lock()
{
	local me=mk_lock
	check_lock
	case ${?} in
		1) return 1 ;;
		2)
			report_curr_action -log
			log_msg -yellow "Refusing to open another instance."
			return 254
	esac

	[ -z "${PID_FILE}" ] && { reg_failure "${me}: \${PID_FILE} variable is unset."; return 1; }

	try_mkdir -p "${ABL_PID_DIR}" || return 1
	printf '%s\n' "${$}" > "${PID_FILE}" || { reg_failure "${me}: Failed to write to pid file '${PID_FILE}'."; return 1; }
	:
}

# assigns lock pid to $LOCK_PID
# return codes:
# 0 - no lock
# 1 - error
# 2 - lock file exists and belongs to another PID
# 3 - lock file belongs to current PID
check_lock()
{
	[ "${LOCK_PID}" = "${$}" ] && return 3
	unset LOCK_PID
	[ -z "${PID_FILE}" ] && { reg_failure "\${PID_FILE} variable is unset."; return 1; }
	[ ! -f "${PID_FILE}" ] && return 0

	read_str_from_file -v "LOCK_PID _" -f "${PID_FILE}" -a 3 -D PID || return 1

	case "${LOCK_PID}" in
		"${$}") return 3 ;;
		*[!0-9]*) reg_failure "PID file '${PID_FILE}' contains unexpected string '${LOCK_PID}'."; unset LOCK_PID; return 1 ;;
		*) kill -0 "${LOCK_PID}" 2>/dev/null && return 2
	esac

	log_msg -warn "Detected stale PID file '${PID_FILE}' for PID ${LOCK_PID}. Removing."
	rm_lock
	:
}

rm_lock()
{
	rm -f "${PID_FILE}"
	rm -rf "${ABL_PID_DIR}"
	LOCK_PID=
	:
}

# updates the pid file with a new action
# 1 - new action
update_action_file()
{
	local me="update_action_file"
	[ -z "${1%.}" ] && { reg_failure "${me}: action is unspecified."; return 1; }

	{
		try_mkdir -p "${ABL_PID_DIR}" &&
		printf '%s\n' "${1%.}" > "${ACTION_FILE}" || reg_failure "${me}: Failed to write to action file '${ACTION_FILE}'."
	} & # runs asynchronously
	:
}

# 1 (optional): '-log' to log current action as well
report_curr_action()
{
	[ "${MSGS_DEST}" = "/dev/null" ] && [ -z "${ABL_LUCI_SOURCED}" ] && [ "${1}" != "-log" ] && return 0
	local reported_pid report_cmd=print_msg curr_action=''
	[ -n "${ACTION_FILE}" ] || { reg_failure "\$ACTION_FILE var is unset."; return 1; }
	[ -f "${ACTION_FILE}" ] || return 0
	check_lock
	case ${?} in
		0) return 0 ;;
		1) return 1 ;;
		2|3) ;;
	esac
	reported_pid="${LOCK_PID:-unknown}"

	read_str_from_file -v curr_action -f "${ACTION_FILE}" -a 2 -D action -V "unknown action"

	[ "${1}" = -log ] && report_cmd=log_msg

	${report_cmd} "adblock-lean (PID: ${reported_pid}) is performing action '${curr_action}'."
	luci_pid_action=${curr_action}
	:
}

wait_on_pid() {
	local i=1 \
		pid="${1}" max_kill_wait_s="${2}"

	while [ -d "/proc/${pid}" ] && [ "${i}" -le "${max_kill_wait_s}" ]
	do
		sleep 1
		i=$((i+1))
	done
}

# kills any running adblock-lean instances
kill_abl_pids()
{
	local IFS="${DEFAULT_IFS}" abl_pids lock_res
	check_lock
	lock_res=${?}
	if [ ${lock_res} = 2 ]
	then
		reg_msg "Another adblock-lean instance is running. Stopping it..."
		kill "${LOCK_PID}" 2>/dev/null
		wait_on_pid "${LOCK_PID}" 5

		check_lock
		lock_res=${?}
	fi

	[ "${lock_res}" = 3 ] && return 0


	if [ -n "${LOCK_PID}" ] && [ "${lock_res}" = 2 ]
	then
		abl_pids="${LOCK_PID}"
	else
		# if PID file doesn't exist, check for running abl processes just in case
		local pgrep_ptrn="(^((sh|/bin/sh)\s+){0,1}(/etc/rc.common\s+){0,1}/etc/(rc.d/S${START}|init.d/)|luci\.)adblock-lean"
		abl_pids="$(${PGREP_CMD:-pgrep} -fa "${pgrep_ptrn}" | ${SED_CMD} -E "/\sstop$/d;s/\s+.*//;/^${$}$/d" | tr '\n' ' ')"
	fi

	if [ -n "${abl_pids}" ]
	then
		kill_pids_recursive "${abl_pids}" || { reg_failure "Failed to stop running adblock-lean processes."; return 1; }
	fi

	rm_lock

	:
}

# kills specified pid's and their offspring
# 1 - whitespace-separated starting list of pid's
# 2 - pid's to exclude
kill_pids_recursive()
{
	get_running_pids() {
		unset_vars "${1}" || return 1
		local _pid _pids=''
		for _pid in ${2}
		do
			[ -d "/proc/${_pid}" ] && _pids="${_pids}${_pid} "
		done
		export -n "${1}=${_pids}"
	}

	# recursively add child pid's of pid $2 to whitespace-separated list stored in var $1
	# 1 - var name for output
	# 2 - pid
	add_child_pids()
	{
		local pid_scan_depth="${pid_scan_depth:=0}" pid prev_pids child_pids
		pid_scan_depth=$((pid_scan_depth+1))
		[ "${pid_scan_depth}" -lt "${max_pid_scan_depth}" ] || return 0

		child_pids="$(
			${PGREP_CMD:-pgrep} -faP "${2}" |
			# exclude the dnsmasq processes and service calls from results
			${SED_CMD} -E \
				'/(^[0-9]+\s+((sh|\/bin\/sh)\s+){0,1}(\/sbin\/service\s+|\/etc\/rc.common\s+\/etc\/init.d\/){0,1}(\/usr\/sbin\/|\/sbin\/service\s){0,1}dnsmasq|\/sbin\/ujail)\s/d;
				s/\s.*//'
		)" && [ -n "${child_pids}" ] || return 0

		eval "prev_pids=\"\${${1}}\""

		local IFS="${_NL_}"
		for pid in ${child_pids}
		do
			IFS="${DEFAULT_IFS}"
			is_included "${pid}" "${prev_pids}" || eval "${1}=\"\${${1}}\${pid} \""
			add_child_pids "${1}" "${pid}"
		done
	}

	local IFS="${DEFAULT_IFS}" initial_pids='' running_pids='' exclude_pids="${2}" pid max_pid_scan_depth=10 max_k_attempts=10

	# compile a list of initial pids and recursively child pids
	for pid in ${1}
	do
		is_uint "${pid}" || continue
		is_included "${pid}" "${exclude_pids}" && continue

		initial_pids="${initial_pids}${pid} "
	done
	[ -n "${initial_pids}" ] || return 0

	running_pids="${initial_pids}"
	k_attempt=0

	while :
	do
		for pid in ${running_pids}
		do
			add_child_pids running_pids "${pid}"
		done

		kill "${running_pids}" 2>/dev/null

		get_running_pids running_pids "${running_pids}" || return 1

		[ -n "${running_pids}" ] || return 0

		k_attempt=$((k_attempt+1))
		[ ${k_attempt} -le ${max_k_attempts} ] || break
		sleep 1
	done

	kill -9 "${running_pids}" 2>/dev/null
	sleep 1

	get_running_pids running_pids "${running_pids}" || return 1
	[ -z "${running_pids}" ] && return 0
	return 1
}

# 1 - types: 'ALL' (doesn't print executable files) or any combination (space-separated) of 'GEN', 'LIB', 'EXTRA', 'EXEC'
print_file_list()
{
	local me=print_file_list file_type files='' IFS="${DEFAULT_IFS}" \
		file_types="${1}"

	assert_set "F_${me}" file_types || return 1

	if [ "${file_types}" = ALL ]
	then
		file_types="${ABL_FILE_TYPES}"
	fi

	for file_type in ${file_types}
	do
		case "${file_type}" in
			GEN|LIB|EXTRA|EXEC)
				eval "files=\"${files}\${ABL_${file_type}_FILES}${_NL_}\"" ;;
			*) reg_failure "${me}: invalid type '${file_type}'"; return 1
		esac
	done

	# remove extra newlines, leading and trailing whitespaces and tabs
	printf '%s\n' "${files}" | ${SED_CMD} "s/^\s*//;s/\s*$//;/^$/d"
	:
}

ver_upd_fixup()
{
	local me=ver_upd_fixup fix_ver='' fix_upd_channel='' md5sums='' \
		curr_ver="${1}" curr_upd_ch="${2}"

	assert_set "F_${me}" curr_ver curr_upd_ch || return 1

	log_msg -purple "Completing adblock-lean version upgrade..."

	# fix version and upd channel strings in installed files, then make md5sum registry
	case "${curr_upd_ch}" in
		''|release|latest) fix_upd_channel=release ;;
		*) fix_upd_channel="${curr_upd_ch}"
	esac

	fix_ver="${curr_ver#v}"
	: "${fix_ver:=dev}"

	# shellcheck disable=SC2046
	/bin/busybox sed -i "
		s/^\s*ABL_VERSION=.*/ABL_VERSION=\"${fix_ver}\"/
		s/^\s*ABL_UPD_CHANNEL=.*/ABL_UPD_CHANNEL=\"${fix_upd_channel}\"/" \
			"${ABL_SERVICE_PATH}" &&
	mkdir -p "${ABL_FILES_REG_PATH%/*}" &&
	set -- $(print_file_list ALL) &&
	IFS="${DEFAULT_IFS}" &&
	md5sums="$(${MD5_CMD} "$@")" && [ -n "${md5sums}" ] &&
	printf '%s\n' "${md5sums}" > "${ABL_FILES_REG_PATH}" ||
		reg_failure "${me}: Failed to register new files. Please re-install adblock-lean."
	:
}

# return codes:
# 0 - OK
# 1 - general error
# 2 - missing files
# 3 - non-matching md5sums
check_libs()
{
	local file files='' reg_file="${ABL_FILES_REG_PATH}"

	files="$(print_file_list ALL)" && [ -n "${files}" ] ||
		{ reg_failure "check_libs: failed to get file list."; return 1; }

	local IFS="${_NL_}"
	for file in ${reg_file}${_NL_}${files}
	do
		[ -n "$file" ] || continue
		[ -f "$file" ] || { reg_failure "Missing file: '$file'."; return 2; }
	done

	IFS="${DEFAULT_IFS}"

	${MD5_CMD} -c "${reg_file}" &>/dev/null || return 3
	:
}

# Env vars: ABL_SOURCE_PATH_PREFIX
source_libs()
{
	[ -n "${LIBS_SOURCED}" ] && return 0

	local file libs_missing='' libs_source_failed=''
	if [ -z "${UPD_SOURCED}" ]
	then
		check_libs
	else
		:
	fi
	case ${?} in
		0|3) ;;
		*)
			log_msg "Please run 'sh /etc/init.d/adblock-lean update -f' to fetch required files."
			return 1
	esac

	# source libs
	for file in ${ABL_LIB_FILES:?}
	do
		file="${file##*/}"
		[ -f "${ABL_SOURCE_PATH_PREFIX}${ABL_LIB_DIR}/${file}" ] || { libs_source_failed=1 libs_missing=1; break; }
		. "${ABL_SOURCE_PATH_PREFIX}${ABL_LIB_DIR}/${file}" || { libs_source_failed=1; break; }
	done

	[ -n "${libs_source_failed}" ] &&
	{
		[ -n "${libs_missing}" ] && reg_failure "Missing library scripts."
		reg_failure "Failed to source library scripts."
		return 1
	}
	LIBS_SOURCED=1
	:
}

# args: 1 - (optional) schedule
# return codes:
# 0 - cron job with same schedule exists
# 1 - error
# 2 - cron job with a different schedule exists
# 3 - cron job doesn't exist
get_curr_crontab()
{
	local curr_cron
	curr_cron="$(crontab -u root -l 2>/dev/null)" || { reg_failure "get_curr_crontab: Failed to read crontab."; return 1; }
	printf '%s\n' "${curr_cron}"

	# check if adblock-lean cron job with same schedule exists
	case "${curr_cron}" in
		*"${upd_schedule}"*"${ABL_CRON_CMD}"*) return 0 ;;
		*"${ABL_CRON_CMD}"*) return 2 ;;
		*) return 3 ;;
	esac
}

rm_cron_job()
{
	local curr_cron
	crontab -u root -l 1>/dev/null 2>/dev/null || return 0
	curr_cron="$(get_curr_crontab)"
	case ${?} in
		1) return 1 ;;
		3) return 0
	esac

	log_msg "" "Removing cron job for adblock-lean."
	printf '%s\n' "${curr_cron}" | ${SED_CMD} '/adblock-lean start/d;/^$/d' | crontab -u root - ||
		{ reg_failure "Failed to update crontab."; return 1; }
	:
}

# Delete adblock-lean addnmount entries for dnsmasq instance
# NOTE: need to run 'uci commit dhcp' after calling this function
# 1 - dnsmasq instance indexes
# return codes:
# 0 - OK
# 1 - Error deleting all found entries
# 2 - Some entries deleted
# 3 - No entries found for instance
del_addnmounts()
{
	local set_id rv path paths entry_deleted=0 entry_failed=0 index persist_dir dir fname persist_dirs
	[ -n "${SET_IDS}" ] ||
		ASSERT_NOEXIT=1 load_config

	for set_id in ${SET_IDS}
	do
		get_params "${set_id}" persist_dir
		add2list persist_dirs "${persist_dir}" "${_NL_}"
	done

	for index in ${1}
	do
		paths="$(
			uci -q get "dhcp.@dnsmasq[${index}].addnmount" 2>/dev/null |
			# handle entries with whitespaces (enclosed in single-quotes) and print each addnmount entry on separate line
			${AWK_CMD} -v quoted="'[^']*'" '
				{
					while (match($0,quoted)) { print substr($0,RSTART+1,RLENGTH-2); before=substr($0,1,RSTART-1); after=substr($0,RSTART+RLENGTH+1); $0 = before after }
					for (i = 1; i <= NF; i++) print $i
				}
			'
		)"
		local IFS="${_NL_}"
		for path in ${paths}
		do
			IFS="${DEFAULT_IFS}"
			case "${path}" in
				''|/) continue ;;
				/bin/busybox*|/usr/bin/logger|*gzip*|*pigz*|*zstd*|*/"${BLOCKSET_BASE_FNAME:?}"*|"${ABL_RUN_DIR:?}"*|"${LOG_CMD%% *}"|"${compression_util%% *}") : ;;
				*) false # ignore addnmounts possibly created not by us
			esac ||
			{
				split_path dir fname _ "${path}"
				is_included "${dir}/${fname}" "${persist_dirs}" "${_NL_}" ||
				is_included "${dir}" "${persist_dirs}" "${_NL_}"
			} ||
			continue
			log_msg -purple "Deleting addnmount entry for dnsmasq instance ${index} (path: ${path})"
			if uci -q del_list "dhcp.@dnsmasq[${index}].addnmount=${path}"
			then
				entry_deleted=1
			else
				entry_failed=1
				reg_failure "Failed to delete addnmount entry for '${path}' from /etc/config/dhcp."
			fi
		done
		IFS="${DEFAULT_IFS}"
	done

	case "${entry_deleted}${entry_failed}" in
		00) rv=3 ;;
		01) rv=1 ;;
		10) rv=0 ;;
		11) rv=2 ;;
	esac

	return ${rv}
}

### Commands init
init_act()
{
	local \
		cfg_req \
		global_cfg_req \
		libs_req \
		work_dir_req \
		log_rotate_req \
		set_ids_req \
		find_set_configs_req \
		act_pr_tmp act_pr act_pr_short \
		log_rotated \
		cur_act="${1}"

	[ -z "${DO_DIALOGS}" ] && [ -z "${ABL_LUCI_SOURCED}" ] && [ -z "${APPROVE_UPD_CHANGES}" ] && [ "${MSGS_DEST}" = "/dev/tty" ] && \
		DO_DIALOGS=1

	debug_msg "init_act '${cur_act}'"

	detect_main_utils || graceful_exit 1

	if [ -z "${ABL_NOTRAPS}" ]
	then
		if [ -n "${UPD_SOURCED}" ]
		then
			trap_and_catch 'exit 1' INT TERM
		else
			trap_and_catch 'cleanup_and_exit 1' INT TERM
			trap 'cleanup_and_exit ${?}' EXIT
		fi
	fi

	# set requirements
	case ${cur_act} in
		enabled|enable|disable|uninstall) ;;
		gen_stats|calculate_limits) libs_req=1 ;;
		status) local SBE_STATUS=1; cfg_req=1 find_set_configs_req=1 set_ids_req=1 work_dir_req=1 ;;
		upd_cron_job) cfg_req=1 ;;
		setup|gen_global_config) find_set_configs_req=1 libs_req=1 LOCK_REQ=1 ;;
		gen_blockset_config) work_dir_req=1 global_cfg_req=1 find_set_configs_req=1 libs_req=1 LOCK_REQ=1 ;;
		rm_blockset_config) libs_req=1 find_set_configs_req=1 set_ids_req=1 LOCK_REQ=1 ;;
		boot|create_addnmounts) cfg_req=1 find_set_configs_req=1 set_ids_req=1 LOCK_REQ=1 ;;
		pause) work_dir_req=1 cfg_req=1 find_set_configs_req=1 set_ids_req=1 LOCK_REQ=1 ;;
		start|resume|gen_persist_blockset) work_dir_req=1 cfg_req=1 find_set_configs_req=1 set_ids_req=1 CLEANUP_REQ=1 LOCK_REQ=1 ;;
		stop)
			check_lock
			case ${?} in
				1) exit 1 ;;
				0|3) ;;
				*) false
			esac ||
			{
				kill_abl_pids
				check_lock
				case ${?} in
					1) exit 1 ;;
					2) reg_failure "Failed to kill running adblock-lean processes."; exit 1
				esac
			}
			libs_req=1 find_set_configs_req=1 CLEANUP_REQ=1 LOCK_REQ=1 ;;
		select_dnsmasq_instances)
			libs_req=1 find_set_configs_req=1 set_ids_req=1 LOCK_REQ=1
			[ "${action}" = select_dnsmasq_instances ] && cfg_req=1 # require config when called directly
			;;
		reload|restart) ;;
		update) work_dir_req=1 CLEANUP_REQ=1 LOCK_REQ=1 ;;
		*) reg_failure "Invalid command '${cur_act}'."; exit 1
	esac

	# source library scripts
	if [ -n "${libs_req}" ] || [ -n "${cfg_req}" ]
	then
		source_libs || exit 1
	fi

	[ -n "${cfg_req}" ] && global_cfg_req=1

	[ -z "${find_set_configs_req}" ] ||
	{
		find_set_configs || exit 1
		[ -n "${PARAMS_RESET}" ] || unset_param_vars "${SET_IDS}"
		PARAMS_RESET=1
	}

	[ -z "${global_cfg_req}" ] || [ -n "${CONFIG_LOADED}" ] || [ -s "${GLOBAL_CFG_FILE:?}" ] ||
		{ reg_failure "Global config file '${GLOBAL_CFG_FILE}' is missing." "Use the command 'service adblock-lean gen_global_config' to create new config."; exit 1; }

	[ -z "${set_ids_req}" ] || [ -n "${SET_IDS}" ] ||
		{ reg_failure "No blockset configs found. Use 'service adblock-lean gen_blockset_config' to generate a new blockset config."; exit 1; }

	# register lock status at init
	check_lock
	local init_lock_status=${?}

	# make lock if needed
	if [ -n "${LOCK_REQ}" ]
	then
		mk_lock || { local rv=${?}; unset LOCK_REQ CLEANUP_REQ; exit ${rv}; }
		act_pr_short="${cur_act}"
	fi

	# enable writing session log for commands which require it if we have the lock
	case ${init_lock_status} in 0|3)
		case "${cur_act}" in
			boot|start|setup|gen_global_config|gen_blockset_config|rm_blockset_config|reload|restart)
				export ABL_CURR_LOG_FILE="${ABL_SESSION_LOG_FILE}"
				log_rotate_req=1
				log_rotated="${ABL_SESSION_LOG_ROTATED}" ;;
			stop|pause|resume|upd_cron_job|select_dnsmasq_instances)
				export ABL_CURR_LOG_FILE="${ABL_SESSION_LOG_FILE}"
				log_rotate_req='' ;;
			update)
				export ABL_CURR_LOG_FILE="${ABL_UPDATE_LOG_FILE}"
				log_rotate_req=1
				log_rotated="${ABL_UPD_LOG_ROTATED}" ;;
		esac
	esac

	# if creating new session, rotate the old session log file
	if [ -n "${log_rotate_req}" ] && [ -n "${ABL_CURR_LOG_FILE}" ] && [ -z "${log_rotated}" ]
	then
		[ -f "${ABL_CURR_LOG_FILE}" ] && mv "${ABL_CURR_LOG_FILE}" "${ABL_CURR_LOG_FILE}.0"
		case "${cur_act}" in
			update) ABL_UPD_LOG_ROTATED=1 ;;
			*) ABL_SESSION_LOG_ROTATED=1
		esac
	fi

	local ver_pr="(version '${ABL_VERSION}')"
	case ${cur_act} in
		boot) act_pr="Initializing adblock-lean ${ver_pr} at boot." ;;
		start) act_pr="Starting adblock-lean ${ver_pr}." ;;
		status) print_msg -purple "" "adblock-lean ${ver_pr} status:" ;;
		enable) act_pr="Enabling the adblock-lean service." ;;
		disable) act_pr="Disabling the adblock-lean service." ;;
		uninstall) act_pr_tmp=Uninstalling ;;
		gen_stats) act_pr="Generating dnsmasq stats." ;;
		upd_cron_job) act_pr_tmp="Updating cron job for" ;;
		gen_persist_blockset) act_pr="Generating persistent blockset." ;;
	esac
	[ -n "${act_pr}" ] || act_pr="${act_pr_tmp:+"${act_pr_tmp} adblock-lean."}"

	if [ -n "${act_pr}" ]
	then
		reg_action -1 -purple "" "${act_pr}" || exit 1
	elif [ -n "${act_pr_short}" ]
	then
		update_action_file "${act_pr_short}"
	fi

	# report installed utils
	if [ "${cur_act}" = start ]
	then
		detect_pkg_manager
		report_utils
	fi

	[ -n "${work_dir_req}" ] && { try_mkdir -p "${ABL_TMP_DIR}" || exit 1; }

	[ -z "${cfg_req}" ] || load_config || exit 1

	# check dnsmasq, source custom script
	case ${cur_act} in
		start|pause|resume)
			if [ -n "${custom_script}" ]
			then
				custom_scr_sourced=
				[ -f "${custom_script}" ] && . "${custom_script}" && custom_scr_sourced=1 ||
					reg_failure "Custom script '${custom_script}' doesn't exist or it returned an error."
			fi
	esac

	:
}

# Get GitHub ref and tarball url for specified component, update channel, branch and version
# 1 - update channel: release|snapshot|branch=<github_branch>|commit=<commit_hash>
# 2 - version (optional): [version|commit_hash]
# Output via variables:
#   $3 - github ref (version/commit hash), $4 - tarball url, $5 - version type ('version' or 'commit')
get_gh_ref()
{
	set_res_vars()
	{
		unset_vars "${3}" "${4}" "${5}" || return 1
		# validate resulting ref
		case "${gr_ref}" in
			*[^"${_NL_}"]*"${_NL_}"*[^"${_NL_}"]*)
				reg_failure "Got multiple download URLs for version '${gr_version}'." \
					"If using commit hash, please specify the complete commit hash string."
				return 1 ;;
			''|*[!a-zA-Z0-9._-]*)
				reg_failure "Failed to get GitHub download URL for ${gr_ver_type} '${gr_version}' (update channel: '${gr_channel}')."
				return 1
		esac

		case "${gr_channel}" in
			release|latest) gr_channel=release gr_version="${gr_ref#v}" ;;
			*) gr_version="${gr_ref}"
		esac

		export -n "${3}=${gr_version}" "${4}=${ABL_GH_URL_API}/tarball/${gr_ref}" "${5}=${gr_ver_type}"
		export "PREV_REF=${gr_ref}" "PREV_VER_TYPE=${gr_ver_type}" \
			"PREV_UPD_CHANNEL=${gr_channel}" "PREV_VERSION=${gr_version}"
	}

	get_and_process_ref()
	{
		local branch url \
			channel="${1}" ptrn="${2}" branches="${3}" err_file="${4}"
		case "${channel}" in
			release)
				uclient-fetch "${ABL_GH_URL_API}/releases" -O- 2> "${err_file}" | {
					jsonfilter -e '@[@.prerelease=false]' |
					jsonfilter -a -e "@[@.target_commitish=\"${ABL_MAIN_BRANCH}\"].tag_name"
					cat 1>/dev/null
				} ;;
			snapshot|branch=*|commit=*)
				for branch in ${branches}
				do
					url="${ABL_GH_URL_API}/commits?sha=${branch}"
					uclient-fetch "${url}" -O- 2> "${err_file}" | {
						jsonfilter -e '@[@.commit]["url"]' |
						${SED_CMD} 's/.*\///' # only leave the commit hash
						cat 1>/dev/null
					}
				done
		esac |
		if [ -n "${ptrn}" ]
		then
			grep "${ptrn}"
		else
			head -n1 # get latest version or commit
			cat 1>/dev/null
		fi
	}

	local gr_branches='' gr_grep_ptrn='' gr_ref='' gr_ver_type='' gr_fetch_rv=0 \
		gr_fetch_tmp_dir="${ABL_UPD_DIR}/ref_fetch" \
		cached_ref cached_ver_type \
		gr_channel="${1}" gr_version="${2}"

	[ "$gr_channel" = release ] && gr_version="${gr_version#v}"

	local gr_ucl_err_file="${gr_fetch_tmp_dir}/ucl_err"

	unset_vars "${3}" "${4}" "${5}" || return 1

	# if commit hash is specified and it's 40-char long, use it directly without API query or cache check
	case "${gr_channel}" in
		snapshot|branch=*|commit=*) [ "${#gr_version}" = 40 ] && gr_ref="${gr_version}"
	esac

	# if previously stored data exists, use it without API query or cache check
	if [ -z "${gr_ref}" ] && [ -n "${PREV_REF}" ] && [ -n "${PREV_VER_TYPE}" ] && \
		[ "${PREV_UPD_CHANNEL}" = "${gr_channel}" ] && [ "${gr_version}" = "${PREV_VERSION}" ]
	then
		gr_ref="${PREV_REF}" gr_ver_type="${PREV_VER_TYPE}"
	elif [ -z "${gr_ref}" ]
	then
		# ref cache
		local cache_ttl cache_file cache_filename="${gr_version}_${gr_channel}" gr_cache_dir="/tmp/abl_cache"
		case "${gr_channel}" in
			commit=*) cache_ttl=2880 ;; # 48 hours
			*) cache_ttl=10 # 10 minutes
		esac

		# clean up old cache
		find "${gr_cache_dir:-?}" -maxdepth 1 -type f -mmin +"${cache_ttl}" -exec rm -f {} \; 2>/dev/null

		# check if the query is cached
		cache_file="$(find "${gr_cache_dir:-?}" -maxdepth 1 -type f -name "${cache_filename}" -print 2>/dev/null)"
		case "${cache_file}" in
			'') ;; # found nothing
			*[^"${_NL_}"]*"${_NL_}"*[^"${_NL_}"]*)
				# found multiple files - delete them
				local file IFS="${_NL_}"
				for file in ${cache_file}
				do
					[ -n "${file}" ] || continue
					rm -f "${file}"
				done
				IFS="${DEFAULT_IFS}" ;;
			*)
				# found cached query
				if [ -z "${IGNORE_CACHE}" ] && [ -f "${cache_file}" ] &&
					read -r cached_ref cached_ver_type < "${cache_file}" &&
					[ -n "${cached_ref}" ] && [ -n "${cached_ver_type}" ]
				then
					gr_ref="${cached_ref}" gr_ver_type="${cached_ver_type}"
				else
					rm -f "${cache_file:-???}"
				fi
		esac
	fi

	if [ -n "${gr_ref}" ]
	then
		set_res_vars "${@}" || return 1
		return 0
	fi

	try_mkdir -p "${gr_fetch_tmp_dir}" || return 1
	rm -f "${gr_ucl_err_file}"

	case "${gr_channel}" in
		release)
			gr_ver_type=version
			[ -n "${gr_version}" ] && gr_grep_ptrn="^v${gr_version#v}$" ;;
		snapshot)
			gr_ver_type=commit
			gr_branches="${ABL_MAIN_BRANCH}"
			[ -n "${gr_version}" ] && gr_grep_ptrn="^${gr_version}$" ;;
		branch=*)
			gr_ver_type=commit
			gr_branches="${gr_channel#*=}"
			[ -n "${gr_version}" ] && gr_grep_ptrn="^${gr_version}$" ;;
		commit=*)
			gr_ver_type=commit
			local gr_hash="${gr_channel#*=}"

			if [ "${#gr_hash}" = 40 ]
			then
				# if upd. ch. is 'commit', the upd. ch. string includes commit hash -
				#    if it's 40-char long, use it directly without API query
				gr_ref="${gr_hash}"
			else
				gr_branches="$(
					uclient-fetch "${ABL_GH_URL_API}/branches" -O-  2> "${gr_ucl_err_file}" |
						{ jsonfilter -e '@[@]["name"]'; cat 1>/dev/null; }
				)"
				[ -n "${gr_branches}" ] || {
					reg_failure "Failed to get adblock-lean branches via GH API (url: '${ABL_GH_URL_API}/branches')."
					[ -f "${gr_ucl_err_file}" ] &&
						log_msg "uclient-fetch log:${_NL_}$(cat "${gr_ucl_err_file}")"
						rm -f "${gr_ucl_err_file}"
					return 1
				}
				rm -f "${gr_ucl_err_file}"
				gr_grep_ptrn="^${gr_hash}"
			fi ;;
		*)
			reg_failure "Invalid update channel '${gr_channel}'."
			return 1
	esac

	# Get GH ref
	[ -z "${gr_ref}" ] &&
		gr_ref="$(get_and_process_ref "${gr_channel}" "${gr_grep_ptrn}" "${gr_branches}" "${gr_ucl_err_file}")"

	if [ -z "${gr_ref}" ]
	then
		gr_fetch_rv=1
		reg_failure "Failed to get GitHub download URL for ${gr_ver_type} '${gr_version}' (update channel: '${gr_channel}')."
		[ -f "${gr_ucl_err_file}" ] && log_msg "uclient-fetch output:${_NL_}$(cat "${gr_ucl_err_file}")"
	fi
	rm -rf "${gr_fetch_tmp_dir:-?}"
	[ "$gr_fetch_rv" = 0 ] || return 1

	# write query result to cache
	try_mkdir -p "${gr_cache_dir}" &&
	printf '%s\n' "${gr_ref} ${gr_ver_type}" > "${gr_cache_dir}/${cache_filename}"

	set_res_vars "${@}" || return 1
	:
}

