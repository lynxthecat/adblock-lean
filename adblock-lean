### UTILITY FUNCTIONS

is_hex_lc() { case "${1}" in ''|*[!0-9a-f]*) false ;; *) :; esac; }

is_uint()
{
	local _v
	for _v in "${@}"
	do
		case "${_v}" in
			''|*[!0-9]*) return 1
		esac
	done
	:
}

# Env vars:
#   ASSERT_NOEXIT: do not exit on error
# Check that required vars are set
# Use only for runtime code integrity validation
# 1: asserting function name, prefixed with 'F_'
# extra args: variable names which must have a value
assert_set()
{
	assert_fail()
	{
		[ -n "${1}" ] && reg_failure "${1}"
		[ -n "${ASSERT_NOEXIT}" ] || exit 1
	}

	local func _val_ne _var_ne _checked='' IFS="${DEFAULT_IFS}"

	case "${1}" in
		F_*)
			func="${1#"F_"}"
			case "${func}" in
				'') false ;;
			esac ;;
		*) false
	esac || { assert_fail "assert_set(): func '${1}' not prefixed with 'F_'"; return 1; }

	shift

	for _var_ne in "${@}"
	do
		eval "_val_ne=\"\${${_var_ne}}\""
		case "${_val_ne}" in
			'') assert_fail "Assertion failed: ${func}(): variable '${_var_ne}' must have a value."; return 1 ;;
			*) _checked=1; continue
		esac
	done

	case "${_checked}" in '') assert_fail "assert_set(): no vars specified by ${func}()"; return 1; esac

	:
}

bad_args()
{
	local arg args func="${1}"
	shift
	for arg in "${@}"
	do
		args="${args}${args:+", "}'${arg}'"
	done
	reg_failure "${func}: bad args: ${args}"
}

unset_vars()
{
	are_var_names_safe "${@}" || return 1
	local var
	for var in "${@}"
	do
		[ -n "${var}" ] && eval "${var}="
	done
	:
}

# check if var names are safe to use with eval
are_var_names_safe() {
	local var_name
	for var_name in "${@}"
	do
		case "${var_name}" in [!a-zA-Z_]*|*[!a-zA-Z0-9_]*) reg_failure "Invalid var name '${var_name}'."; return 1; esac
	done
	:
}

# Env vars:
#   FF_RM_EXTRA: remove 2nd and further found files
#   FF_FIRST: return only the first found file
#   FF_EXEC=<cmd>: execute command for each found and processed file. '{}' in <cmd> is replaced with path to file.
# Args:
#   1: var name for newline-separated paths output
#   2: dir
#   3: filename prefix
find_files()
{
	local me=find_files exec='' ff_file ff_found='' \
		ff_path_out_var="${1}" ff_dir="${2}" ff_prefix="${3}" ff_suffix="${4}" bl_id="${5:?}"

	unset_vars "${ff_path_out_var}" || return 1

	[ -n "${FF_EXEC}" ] && { check_util "${FF_EXEC%% *}" || { reg_failure "${me}: invalid exec cmd '${FF_EXEC}'"; return 1; }; }

	for ff_file in "${ff_dir}/${ff_prefix}"*"${ff_suffix}"
	do
		case "${ff_file}" in ''|*"*") continue; esac
		[ -f "${ff_file}" ] || continue # ignore dirs and symlinks
		[ -n "${ff_found}" ] && [ -n "${FF_RM_EXTRA}" ] && { rm_if_writable "${bl_id}" "${ff_file}"; continue; }

		[ -n "${FF_EXEC}" ] &&
		{
			exec="${FF_EXEC//"{}"/"\"${ff_file}\""}"
			eval "${exec}" || { reg_failure "${me}: '${exec}' returned code ${?}"; return 1; }
		}

		ff_found="${ff_found}${ff_found:+"${_NL_}"}${ff_file}"

		[ -n "${FF_FIRST}" ] && [ -z "${FF_RM_EXTRA}" ] && break
	done

	[ -n "${ff_found}" ] || return 2

	eval "${ff_path_out_var:-_}"='${ff_found}' || return 1
	:
}

check_func()
{
	check_util "${1}" && [ "$(type "${1}" 2>/dev/null | head -n1)" = "${1} is a function" ]
}

check_util()
{
	command -v "${1}" 1>/dev/null
}

# sets global variables for colors, tab delimiter and cr_lf
set_ansi()
{
	local IFS=" "
	# shellcheck disable=SC2046
	set -- $(printf '\033[0;31m \033[0;32m \033[1;34m \033[1;33m \033[0;35m \033[0m \35 \t \r')
	export red="${1}" green="${2}" blue="${3}" yellow="${4}" purple="${5}" n_c="${6}" _DELIM_="${7}" TAB="${8}" CR="${9}" CR_LF="${9}${_NL_}"
}

# checks if string $1 is included in space-separated list $2
# if $3 is specified, uses the value as list delimiter
# result via return status
is_included() {
	local delim="${3:-" "}"
	case "${delim}${2}${delim}" in
		*"${delim}${1}${delim}"*)
			return 0 ;;
		*)
			return 1
	esac
}

# adds a string to a space-separated list if it's not included yet
# 1 - name of var which contains the list
# 2 - new value(s)
# 3 - (optional) list delimiter (instead of whitespace)
# returns 1 if bad var name, 0 otherwise
add2list() {
	case "${1}" in *[!A-Za-z0-9_]*)
		return 1
	esac

	local a2l_val curr_list delim="${3:-" "}"

	eval "curr_list=\"\${${1}}\""
	local IFS="${delim}"
	for a2l_val in ${2}
	do
		case "${a2l_val}" in '') continue; esac
		is_included "${a2l_val}" "${curr_list}" "${delim}" && continue
		curr_list="${curr_list}${curr_list:+"${delim}"}${a2l_val}"
	done
	eval "${1}"='${curr_list}'
	:
}

# subtract list $1 from list $2, with optional field separator $4 (otherwise uses whitespace)
# output via optional variable with name $3
# returns status 0 if the result is null, 1 if not
subtract_a_from_b() {
	local sab_out="${3:-___dummy}" IFS="${DEFAULT_IFS}"
	are_var_names_safe "${sab_out}" || return 1
	case "${2}" in '') eval "${sab_out}=''"; return 0; esac
	case "${1}" in '') eval "${sab_out}"='${2}'; [ ! "${2}" ]; return; esac
	local _fs_su="${4:-" "}"
	local e rv_su=0 _subt=
	local IFS="${_fs_su}"
	for e in ${2}; do
		is_included "${e}" "${1}" "${_fs_su}" || { add2list _subt "${e}" "${_fs_su}"; rv_su=1; }
	done
	eval "${sab_out}"='$_subt'
	return ${rv_su}
}

# reads first line from file into variables
# Args:
# -v <out_var_name>
# -f <file_path>
# Optional args:
# '-a <attempts_num>'
# '-d' to delete the file after reading
# '-q' to quiet error message
# '-n X' to limit number of bytes read
# '-D <"[file_desc]">'
# '-V <"[default_val]">'
# '-F <"[fs_char]">'
# '-E <"[eof_char]">'
read_str_from_file()
{
	local me=read_str_from_file rs_del_file='' rs_quiet='' rs_num_bytes='' rs_outvars='' rs_file='' \
		rs_file_desc='' rs_def_val='' rs_read_failed='' rs_attempts=1 rs_attempt rs_var rs_fs="${DEFAULT_IFS}" rs_eof="${_NL_}" \
		IFS="${DEFAULT_IFS}"
	while getopts ":dqn:v:f:a:D:V:F:E:" opt
	do
		case "${opt}" in
			d) rs_del_file=1 ;;
			q) rs_quiet=1 ;;
			n) rs_num_bytes=-n${OPTARG} ;;
			v) rs_outvars=${OPTARG} ;;
			f) rs_file=${OPTARG} ;;
			a) rs_attempts=${OPTARG} ;;
			D) rs_file_desc=${OPTARG} ;;
			V) rs_def_val=${OPTARG} ;;
			F) rs_fs="${OPTARG}" ;;
			E) rs_eof="${OPTARG}" ;;
			*) reg_failure "${me}: unexpected option '${opt}'."; return 1;
		esac
	done

	assert_set "F_${me}" rs_outvars rs_file &&
	unset_vars ${rs_outvars} || return 1

	rs_attempt=0
	while :
	do
		rs_attempt=$((rs_attempt+1))
		[ "${rs_attempt}" -le "${rs_attempts}" ] || { rs_read_failed=1; break; }
		[ "${rs_attempt}" = 1 ] || sleep 1

		IFS="${rs_fs}" read -r -d "${rs_eof}" ${rs_num_bytes?} ${rs_outvars?} 2>/dev/null < "${rs_file}"
		for rs_var in ${rs_outvars}
		do
			case "${rs_var}" in _) continue; esac
			eval "[ -n \"\${${rs_var}}\" ]" || continue 2
		done
		break
	done

	[ -n "${rs_del_file}" ] && rm -f "${rs_file}"
	[ -z "${rs_read_failed}" ] && return 0

	for rs_var in ${rs_outvars}
	do
		eval "${rs_var}=\"${rs_def_val}\""
	done

	[ -n "${rs_quiet}" ] || reg_failure "Failed to read${rs_file_desc:+ }${rs_file_desc} file '${rs_file}'."

	return 1
}

# 0 - (optional) '-p'
# 1 - path
try_mkdir()
{
	local p=
	[ "${1}" = '-p' ] && { p='-p'; shift; }
	[ -d "${1}" ] && return 0
	mkdir ${p} "${1}" || { reg_failure "Failed to create directory '${1}'."; return 1; }
	:
}

# asks the user to pick an option
# 1 - input in the format 'a|b|c'
# output via $REPLY
pick_opt()
{
	update_action_file "Waiting for user input in console" || return 1
	while :
	do
		printf %s "$1: " > "${MSGS_DEST}"
		read -r REPLY
		case "$REPLY" in *[!A-Za-z0-9_]*) printf '\n%s\n\n' "Please enter $1" > "${MSGS_DEST}"; continue; esac
		eval "case \"$REPLY\" in 
				$1) return 0 ;;
				*) printf '\n%s\n\n' \"Please enter $1\" > \"${MSGS_DEST}\"
			esac"
	done
}


### HELPER FUNCTIONS

# Splits path to file into dir, filename, ext
split_path()
{
	local sp_file='' sp_fname='' sp_ext='' sp_dir='' \
		sp_dir_out_var="${1}" sp_fname_out_var="${2}" sp_ext_out_var="${3}" sp_path="${4}"

	unset_vars "${sp_dir_out_var}" "${sp_fname_out_var}" "${sp_ext_out_var}" || return 1

	case "${sp_path}" in
		# ignore files directly in /
		/[!/]*)
			sp_file="${sp_path##*"/"}"
			sp_fname="${sp_file%.*}"
			case "${sp_file}" in
				*.*) sp_ext="${sp_file##*.}" ;;
			esac
	esac

	[ -n "${sp_fname}" ] || return 1

	sp_dir="${sp_path%"${sp_file}"}"
	sp_dir="${sp_dir%"/"}"
	: "${sp_ext}"

	[ -n "${sp_dir}" ] && [ -n "${sp_fname}" ] &&
	eval "${sp_dir_out_var}"='${sp_dir}' "${sp_fname_out_var}"='${sp_fname}' "${sp_ext_out_var}"='${sp_ext}'
}

is_valid_dir()
{
	local fail_cmd="reg_failure"
	[ "${1}" = '-q' ] && { fail_cmd="debug_msg"; shift; }
	case "${1}" in
		''|"/"|[!/]*) ${fail_cmd} "Unexpected or invalid dir '${1}'."; return 1
	esac
	:
}

is_dir_writable()
{
	local persist_dir persist_mode
	is_valid_dir -q "${2}" &&
	get_bl_params "${1}" persist_dir persist_mode || return 1

	{ [ -n "${persist_dir}" ] && [ "${2}" != "${persist_dir}" ]; } ||
	{ [ "${persist_mode}" = managed ] && [ "${KEEP_PERSIST}" != 1 ]; } ||
	{
		[ -z "${persist_dir}" ] &&
		case "${2}" in
			/tmp|/tmp/*|"${ABL_RUN_DIR:?}"*) : ;;
			*) false
		esac
	}
}

rm_if_writable()
{
	local dir filename path removed='' \
		bl_id="${1:?}"
	shift
	for path in "${@}"
	do
		split_path dir filename _ "${path}" &&
		[ -n "${dir}" ] && [ -n "${filename}" ] &&
		is_dir_writable "${bl_id}" "${dir}" || continue

		rm -f "${dir}/${filename}" "${dir}/${filename}."*
		removed=1
	done
	[ -n "${removed}" ]
}

rm_bk()
{
	local bl_id bk_file bl_ids="${*:-"${BL_IDS}"}"
	for bl_id in ${bl_ids}
	do
		get_bl_params "${bl_id}" bk_file &&
		[ -n "${bk_file}" ] &&
		rm_if_writable "${bl_id}" "${bk_file}" &&
		set_bl_params "${bl_id}" "bk_file="
	done
}

# Env vars:
# KEEP_PERSIST
rm_blocklists()
{
	local bl_id curr_path curr_persist_path \
		bl_ids="${*:-"${BL_IDS}"}"

	for bl_id in ${bl_ids}
	do
		get_bl_params "${bl_id}" curr_path curr_persist_path &&
		[ -n "${curr_path}" ] || [ -n "${curr_persist_path}" ] || continue

		rm_if_writable "${bl_id}" "${curr_path}"
		set_bl_params "${bl_id}" curr_path= curr_location= curr_md5= curr_cnt=

		[ -n "${curr_persist_path}" ] && is_dir_writable "${curr_persist_path%/*}" "${bl_id}" &&
		{
			rm -f "${curr_persist_path}" "${curr_persist_path%/*}/${META_FNAME_PERSIST}"
			set_bl_params "${bl_id}" curr_persist_path= curr_persist_md5= curr_persist_cnt=
		}
	done
