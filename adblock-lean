# 1 (optional): blocklist IDs (defaults to all)
start()
{
	# global vars which may be set in set_bl_env()
	BLOCKLISTS_TO_INSTALL=''
	BLOCKLISTS_TO_GEN=''

	init_command start || exit 1

	if [ "${RANDOM_DELAY}" = "1" ]
	then
		random_delay_mins=$(($(hexdump -n 1 -e '"%u"' </dev/urandom)%60))
		reg_action -1 -purple "Delaying automatic lists update by ${random_delay_mins} minutes (thundering herd prevention)." || exit 1
		sleep "${random_delay_mins}m" &
		wait ${!}
	fi

	local \
		installed_blocklists='' \
		blocklists_to_retry='' \
		restored_blocklists='' \
		ok_blocklists='' \
		perm_failed_blocklists='' \
		run_state \
		start_rv=1 \
		initial_uptime_cs \
		elapsed_time \
		curr_cnt \
		install_path install_cnt \
		final_compr_to_file \
		bk_file \
		bl_id \
		bl_ids="${*:-"${BL_IDS}"}"
	local failed_blocklists="${bl_ids}"

	: "${install_cnt}"

	FAIL_STOP_REQ=1

	get_uptime_cs initial_uptime_cs

	set_global_env "${bl_ids}" || exit 1

	rm_conf_scripts "${bl_ids}"

	# Initial values of BLOCKLISTS_TO_INSTALL, BLOCKLISTS_TO_GEN are set by set_global_env()

	# gen_blocklists() and install_blocklists() append values to output vars

	[ -n "${BLOCKLISTS_TO_GEN}" ] &&
		gen_blocklists BLOCKLISTS_TO_INSTALL "${BLOCKLISTS_TO_GEN}" "${initial_uptime_cs}" 

	[ -n "${BLOCKLISTS_TO_INSTALL}" ] &&
		install_blocklists ok_blocklists perm_failed_blocklists "${BLOCKLISTS_TO_INSTALL}"
	subtract_a_from_b "${ok_blocklists}" "${failed_blocklists}" failed_blocklists
	subtract_a_from_b "${ok_blocklists} ${perm_failed_blocklists}" "${BLOCKLISTS_TO_INSTALL}" blocklists_to_retry

	[ -n "${blocklists_to_retry}" ] &&
	{
		BLOCKLISTS_TO_INSTALL=
		log_msg -blue "" "Trying again to generate and install blocklists: ${blocklists_to_retry}."
		gen_blocklists BLOCKLISTS_TO_INSTALL "${blocklists_to_retry}" "${initial_uptime_cs}"

		[ -n "${BLOCKLISTS_TO_INSTALL}" ] &&
			install_blocklists ok_blocklists _ "${BLOCKLISTS_TO_INSTALL}"
		subtract_a_from_b "${ok_blocklists}" "${failed_blocklists}" failed_blocklists
	}

	[ -n "${failed_blocklists}" ] &&
	{
		BLOCKLISTS_TO_INSTALL=
		for bl_id in ${failed_blocklists}
		do
			get_bl_params "${bl_id}" bk_file curr_cnt final_compr_to_file
			if [ -f "${bk_file}" ]
			then
				local bl_pr="blocklist ${bl_id} from backup"
				log_msg -blue "" "Preparing to restore ${bl_pr}."

				set_bl_params "${bl_id}" "install_cnt=${curr_cnt}" && # sets global INSTALL_* and local install_* vars
				if \
					mv_blocklist "${bk_file}" "${install_path}" "${final_compr_to_file}" "${bl_id}" &&
					add2list BLOCKLISTS_TO_INSTALL "${bl_id}" &&
					subtract_a_from_b "${bl_id}" "${failed_blocklists}" failed_blocklists
				then
					:
				else
					reg_failure "Failed to restore ${bl_pr} file '${bk_file}'."
					rm_bk "${bl_id}"
				fi
			else
				log_msg -yellow "" "Previous blocklist file does not exist - can not restore."
			fi
		done

		[ -n "${BLOCKLISTS_TO_INSTALL}" ] &&
			install_blocklists restored_blocklists _ "${BLOCKLISTS_TO_INSTALL}"
		subtract_a_from_b "${restored_blocklists}" "${failed_blocklists}" failed_blocklists

		[ -n "${restored_blocklists}" ] && log_msg "Successfully restored blocklists from backup: ${blue}${restored_blocklists}${n_c}."

		[ -n "${failed_blocklists}" ] &&
		{
			rm_bk "${failed_blocklists}"
			do_stop "${failed_blocklists}"
			reg_failure "Blocklists '${failed_blocklists}' failed to install and can not be restored from backup."
		}
	}

	subtract_a_from_b "${failed_blocklists} ${restored_blocklists}" "${bl_ids}" installed_blocklists

	for bl_id in ${installed_blocklists}
	do
		set_bl_params "${bl_id}" run_state=0
	done

	[ -n "${installed_blocklists}" ] && 
	{
		start_rv=0
		reg_success "${green}Successfully installed blocklists:${n_c} ${blue}${installed_blocklists}${n_c}."
	}

	commit_metadata "${bl_ids}" || { do_stop; start_rv=1; }

	# if [ "${installed_path%/*}" = "${PERSIST_BLOCKLIST_DIR}" ]
	# then
	# 	mk_hotplug_script "${installed_path}"
	# else
	# 	disable_hotplug_script
	# fi

	[ "${start_rv}" = 0 ] &&
	{
		get_elapsed_time_human elapsed_time "${initial_uptime_cs}"
		reg_msg "" "Processing time for blocklist generation and import: ${blue}${elapsed_time:-"${yellow}unknown"}${n_c}"
	}

	FAIL_STOP_REQ=

	check_for_updates
	exit ${start_rv}
}

gen_persist_blocklist()
{
	init_command gen_persist_blocklist || exit 1

	local err_msg bl_id ok_bl_ids persist_mode persist_dir \
		bl_ids="${*:-"${BL_IDS}"}"

	for bl_id in ${bl_ids}
	do
		get_bl_params "${bl_id}" persist_mode persist_dir
		case "${persist_mode}" in
			manual|managed) : ;;
			*) err_msg="'PERSIST_MODE' config option is '${persist_mode}' for blocklist ${bl_id}"; continue
		esac &&
		{
			[ -n "${persist_dir}" ] || { err_msg="'PERSIST_DIR' config option is not set for blocklist '${bl_id}'"; false; }
		} ||
		{ reg_failure "${err_msg} - can not generate persitent file for blocklist ${bl_id}."; continue; }

		set_bl_params "${bl_id}" "persist_mode=managed" # temporarily overrides the config value to enable updating the file
		add2list ok_bl_ids "${bl_id}"
	done

	[ -n "${ok_bl_ids}" ] &&
	{
		print_msg ""
		set_global_env "${ok_bl_ids}" || exit 1
		start "${ok_bl_ids}"
	}
}


