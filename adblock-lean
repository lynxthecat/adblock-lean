# 1 (optional): blockset IDs (defaults to all)
do_start()
{
	# global vars which may be set in set_bl_env()
	BLOCKSETS_TO_INSTALL=''
	BLOCKSETS_TO_GEN=''

	local CUR_CMD=start

	if [ "${RANDOM_DELAY}" = "1" ]
	then
		random_delay_mins=$(($(hexdump -n 1 -e '"%u"' </dev/urandom)%60))
		reg_action -1 -purple "Delaying automatic lists update by ${random_delay_mins} minutes (thundering herd prevention)." || exit 1
		sleep "${random_delay_mins}m" &
		wait ${!}
	fi

	local \
		installed_ids='' \
		retry_ids='' \
		restored_ids='' \
		ok_ids='' \
		fail_ids \
		perm_fail_ids='' \
		do_start_rv=1 \
		initial_uptime_cs \
		elapsed_time \
		curr_cnt \
		install_path \
		final_compr_to_file \
		bk_file \
		bk_cnt \
		set_id set_ids \
		set_ids_arg="${*:-"${SET_IDS}"}"

	get_valid_set_ids set_ids "${set_ids_arg}" || return 1
	[ -n "${set_ids}" ] || exit 0

	fail_ids="${set_ids}"

	get_uptime_cs initial_uptime_cs

	set_all_env "${set_ids}" || exit 1

	debug_msg "BLOCKSETS_TO_GEN:${BLOCKSETS_TO_GEN};BLOCKSETS_TO_INSTALL:${BLOCKSETS_TO_INSTALL};"

	rm_conf_scripts "${set_ids}"

	# Initial values of BLOCKSETS_TO_INSTALL, BLOCKSETS_TO_GEN are set by set_blocksets_env()

	# gen_blocksets() and install_blocksets() append values to output vars

	[ -n "${BLOCKSETS_TO_GEN}" ] &&
		gen_blocksets BLOCKSETS_TO_INSTALL "${BLOCKSETS_TO_GEN}" "${initial_uptime_cs}"

	[ -n "${BLOCKSETS_TO_INSTALL}" ] &&
		install_blocksets ok_ids perm_fail_ids "${BLOCKSETS_TO_INSTALL}"

	subtract_a_from_b "${ok_ids}" "${fail_ids}" fail_ids
	subtract_a_from_b "${ok_ids} ${perm_fail_ids}" "${BLOCKSETS_TO_INSTALL}" retry_ids

	[ -n "${retry_ids}" ] &&
	{
		BLOCKSETS_TO_INSTALL=
		log_msg -fb "${retry_ids}" "" "Trying again to generate and install blockset files{}."
		gen_blocksets BLOCKSETS_TO_INSTALL "${retry_ids}" "${initial_uptime_cs}"

		[ -n "${BLOCKSETS_TO_INSTALL}" ] &&
			install_blocksets ok_ids _ "${BLOCKSETS_TO_INSTALL}"
		subtract_a_from_b "${ok_ids}" "${fail_ids}" fail_ids
	}

	[ -n "${fail_ids}" ] &&
	{
		BLOCKSETS_TO_INSTALL=
		for set_id in ${fail_ids}
		do
			local bl_pr="blockset file from backup{}"
			get_params "${set_id}" bk_file bk_cnt final_compr_to_file install_path
			if [ -f "${bk_file}" ]
			then
				log_msg -b "${set_id}" "" "Preparing to restore ${bl_pr}."

				set_params "${set_id}" "install_cnt=${bk_cnt}" &&
				if mv_blockset "${bk_file}" "${install_path}" "${final_compr_to_file}" "${set_id}"
				then
					add2list BLOCKSETS_TO_INSTALL "${set_id}"
				else
					reg_failure "Failed to restore ${bl_pr}."
					rm_bk "${set_id}"
				fi
			else
				log_msg -yellow -b "${set_id}" "" "Can not restore ${bl_pr} because backup file does not exist."
			fi
		done

		[ -n "${BLOCKSETS_TO_INSTALL}" ] &&
			install_blocksets restored_ids _ "${BLOCKSETS_TO_INSTALL}"
		subtract_a_from_b "${restored_ids}" "${fail_ids}" fail_ids

		[ -n "${restored_ids}" ] && log_msg -fb "${restored_ids}" "${green}Successfully restored blockset files from backup${n_c}{}."

		[ -n "${fail_ids}" ] &&
		{
			rm_bk "${fail_ids}"
			do_stop "${fail_ids}"
			reg_failure -fb "${fail_ids}" "Failed to install new blockset files and can not be restore previous files from backup{}."
		}
	}

	subtract_a_from_b "${fail_ids} ${restored_ids}" "${set_ids}" installed_ids

	[ -n "${installed_ids}" ] &&
	{
		set_params "${installed_ids}" run_state=0
		do_start_rv=0
		reg_success -fb "${installed_ids}" "" "${green}Successfully installed blockset files${n_c}{}."
	}

	commit_metadata || { do_stop; do_start_rv=1; }

	# if [ "${installed_path%/*}" = "${persist_blockset_dir}" ]
	# then
	# 	mk_hotplug_script "${installed_path}"
	# else
	# 	disable_hotplug_script
	# fi

	[ "${do_start_rv}" = 0 ] &&
	{
		get_elapsed_time_human elapsed_time "${initial_uptime_cs}"
		reg_msg "" "Processing time for blockset generation and import: ${lblue}${elapsed_time:-"${yellow}unknown"}${n_c}"
	}

	:
}

gen_persist_blockset()
{
	local CUR_ACT=gen_persist_blockset
	local CUR_CMD=${CUR_ACT}
	init_act "${CUR_ACT}" || exit 1

	local err_msg set_ids set_id ok_set_ids persist_mode persist_dir \
		set_ids_arg="${*:-"${SET_IDS}"}"

	get_valid_set_ids set_ids "${set_ids_arg}" || return 1

	for set_id in ${set_ids}
	do
		err_msg=
		get_params "${set_id}" persist_mode persist_dir || return 1
		case "${persist_mode}" in
			manual|managed) : ;;
			*) err_msg="'persist_blockset_mode' config option is '${persist_mode}'{}"; false
		esac &&
		{
			[ -n "${persist_dir}" ] || { err_msg="'persist_blockset_dir' config option is not set{}"; false; }
		} &&
		set_params "${set_id}" "persist_mode=managed" || # temporarily overrides the config value to enable updating the file
			{ reg_failure -fb "${set_id}" "${err_msg}${err_msg:+". "}Can not generate persitent blockset file{}."; continue; }

		add2list ok_set_ids "${set_id}"
	done

	[ -n "${ok_set_ids}" ] &&
		FORCE_PERSIST_INSTALL=1 do_start "${ok_set_ids}"
}

