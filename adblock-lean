}

reg_success() { log_msg -report "${@}"; }

reg_action() { reg_msg -action "${@}"; }

print_msg() { reg_msg -4 "${@}"; }

log_msg() { reg_msg -1 "${@}"; }

debug_msg()
{
	local prefix="${yellow}debug:${n_c}"
	case ${#} in
		1) reg_msg -5 "${prefix} ${1}" ;;
		*) reg_msg -5 "" "${prefix}" "${@}" ""
	esac	
